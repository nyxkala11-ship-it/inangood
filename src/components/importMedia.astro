---
export interface Props {
    productId: string;
    mediaName: string | any;
    type: "image" | "video";
    alt?: string;
    class?: string;
}

const {
    productId,
    mediaName,
    type,
    alt = "",
    class: className = "",
} = Astro.props;

let src = "";

if (mediaName) {
    if (typeof mediaName === "string") {
        src = mediaName;
    } else if (mediaName.default) {
        src = mediaName.default;
    } else {
        src = mediaName;
    }
}
---

{
    type === "image" ? (
        <img
            src={src}
            alt={alt}
            loading="lazy"
            class={`w-full h-full object-cover rounded-2xl ${className}`}
        />
    ) : (
        <div class="relative w-full aspect-video bg-black rounded-3xl overflow-hidden flex items-center justify-center">
            <video
                src={src}
                controls
                loop
                playsinline
                muted
                class={`w-full h-full object-cover ${className}`}
                aria-label={alt}
            >
                <source src={src} type="video/mp4" />
                Trình duyệt không hỗ trợ video.
            </video>
        </div>
    )
}
