---
import { Search } from "@lucide/astro";
---

<form
    id="form-search"
    class="flex items-stretch grow place-content-center content-center h-auto w-auto"
>
    <!-- Thanh tìm kiếm -->
    <input
        class="rounded-[3rem] flex-1 px-4 focus:outline-none"
        id="MenuSearch"
        type="text"
        placeholder="Tìm ấn phẩm, dịch vụ"
        required
    />
    <button
        id="searchBtn"
        type="submit"
        class="inline px-3 self-center my-auto"
    >
        <Search size={35} color="#fff" />
    </button>
</form>

<style>
    #MenuSearch[type="text"] {
        float: right;
        padding: 0.5rem;
        padding-left: 1rem;
        border: none;
        margin-top: 0.5rem;
        margin-right: 0.5rem;
        font-size: 1.05rem;
        background-color: aliceblue;
        margin: 0.625rem;
        right: 0;
        max-lines: 1;
        height: 2.5rem;
        width: 21.875rem;
    }

    @media screen and (max-width: 600px) {
        #MenuSearch[type="text"] {
            width: auto;
            min-width: 100%;
            overflow: hidden;
        }
        #form-search {
            padding: 0 0.5rem;
            margin-inline: auto;
            flex-grow: 0;
            width: 80vw;
        }
        #MenuSearch[type="text"] {
            left: 0;
            display: flex;
            position: static;
            flex-grow: 1;
        }
    }
</style>

<script>
    const formSearch = document.getElementById("form-search");
    const searchInput = document.getElementById(
        "MenuSearch",
    ) as HTMLInputElement;

    formSearch?.addEventListener("submit", (e) => {
        e.preventDefault();

        const query = searchInput?.value.trim();

        if (!query) {
            alert("Vui lòng nhập từ khóa tìm kiếm!");
            searchInput?.focus();
            return;
        }

        // Chuyển hướng đến trang search với query string
        window.location.href = `/search?q=${encodeURIComponent(query)}`;
    });
</script>
