---
// Cấu hình Splide  -  yêu cầu npm install astro-splide @splidejs/splide-extension-auto-scroll
import "@splidejs/splide";
import { SplideExtension, SplideSlide } from "astro-splide";
import type { Options } from "@splidejs/splide";
import { Image } from "astro:assets";
import fg from "fast-glob";

const ImagesSlide: string[] = fg.sync(
    "./src/assets/slides/*.{jpg,png,webm,gif}",
);

interface Props {
    imagePath: string;
    altText: string;
    name: string;
    age: number;
}

const options: Options = {
    type: "loop",
    drag: "free",
    focus: "center",
    perPage: 8,
    autoScroll: {
        speed: 2,
    },
};

const optionMobile: Options = {
    type: "loop",
    drag: "free",
    focus: "center",
    perPage: 5,
    autoScroll: {
        speed: 1,
    },
};
---

<div id="slideCom">
    <div class="content">
        <SplideExtension options={options}>
            {
                ImagesSlide.map((img) => (
                    <SplideSlide>
                        <img src={img} alt={""} />
                    </SplideSlide>
                ))
            }
        </SplideExtension>
    </div>
</div>

<div id="slideMobile">
    <div class="content">
        <SplideExtension options={optionMobile}>
            {
                ImagesSlide.map((img) => (
                    <SplideSlide>
                        <img src={img} alt={""} />
                    </SplideSlide>
                ))
            }
        </SplideExtension>
    </div>
    <style>
        #slideMobile {
            display: none;
        }
        #slideCom {
            display: contents;
        }
        .content {
            width: 1440px;
            max-width: 100%;
        }
        img {
            padding: 3px;
            width: auto;
            height: auto;
            border-radius: 10px;
        }
        @media screen and (max-width: 600px) {
            #slideCom {
                display: none;
            }
            #slideMobile {
                display: contents;
            }
        }
    </style>

    <script>
        import { AutoScroll } from "@splidejs/splide-extension-auto-scroll";
        import { initSplideExtension } from "astro-splide/js/splideExtensionUtils";
        initSplideExtension({ AutoScroll });
    </script>
</div>
