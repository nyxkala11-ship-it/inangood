---
// src/components/Slide.astro
import { SplideExtension, SplideSlide } from "astro-splide";
import type { Options } from "@splidejs/splide";
import { AutoScroll } from "@splidejs/splide-extension-auto-scroll";

const allImages = Object.values(
    import.meta.glob<{ default: ImageMetadata }>(
        "/src/assets/slides/*.{jpeg,jpg,png,gif}",
        { eager: true }, // Dùng eager để load đồng bộ
    ),
).map((img) => img.default.src);

// ==================== OPTIONS ====================
const sliderOptions: Options = {
    type: "loop",
    drag: "free",
    focus: "center",
    perPage: 5,
    perMove: 1,
    gap: "1.5rem",
    autoScroll: {
        speed: 2,
        pauseOnHover: true,
    },
    pagination: true,
    paginationDirection: "ltr",
    paginationKeyboard: true,
    breakpoints: {
        640: {
            perPage: 2,
            gap: "1rem",
            autoScroll: { speed: 1.2 },
        },
        768: {
            perPage: 3,
            gap: "1.25rem",
            autoScroll: { speed: 1.5 },
            pagination: false,
        },
        1024: {
            perPage: 5,
            gap: "1.4rem",
        },
        1280: {
            perPage: 5,
            gap: "1.5rem",
        },
    },
};
---

<div class="slider-wrapper max-w-360 mx-auto px-4 lg:px-0 py-8">
    <SplideExtension options={sliderOptions}>
        {
            allImages.map((img) => (
                <SplideSlide>
                    <img
                        src={img}
                        alt=""
                        class="aspect-square overflow-hidden h-full"
                    />
                </SplideSlide>
            ))
        }
    </SplideExtension>
</div>

<style>
    .slider-wrapper {
        width: 1440px;
        max-width: 100%;
    }

    .slider-img {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 12px;
        padding: 4px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }

    .splide__slide:hover .slider-img {
        transform: scale(1.04);
    }
</style>

<script>
    import { AutoScroll } from "@splidejs/splide-extension-auto-scroll";
    import { initSplideExtension } from "astro-splide/js/splideExtensionUtils";
    initSplideExtension({ AutoScroll });
</script>
