---
// src/components/CategoryTags.astro
import { getCollection } from "astro:content";

const allPosts = await getCollection("blogCollection");

// Lấy tất cả tags và loại bỏ trùng lặp
const allTags = new Set<string>();
allPosts.forEach((post) => {
    post.data.tags?.forEach((tag) => allTags.add(tag));
});

// Chuyển thành mảng và sắp xếp alphabet
let tagsArray = Array.from(allTags).sort((a, b) => a.localeCompare(b));

// Random nhẹ trên client-side (tùy chọn)
// const shuffledTags = tagsArray; // Nếu muốn random mỗi lần load thì uncomment dòng dưới
const shuffledTags = tagsArray.sort(() => Math.random() - 0.5).slice(0, 15);
---

<div id="cater-container" class="max-w-[1440px] mx-auto px-4 py-8">
    <div class="text-center mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-[#781722]">
            Thẻ Danh Mục
        </h1>
        <p class="text-gray-600 mt-2">
            Khám phá các sản phẩm theo danh mục ngẫu nhiên
        </p>
    </div>

    <div class="flex flex-wrap justify-center gap-3 md:gap-4">
        {
            shuffledTags.map((tag) => (
                <a href={`/tags/${tag.toLowerCase()}`} class="tag-item group">
                    #{tag}
                </a>
            ))
        }
    </div>
</div>

<style>
    #cater-container {
        width: 1440px;
        max-width: 100%;
        margin: 0 auto;
    }

    .tag-item {
        display: inline-flex;
        align-items: center;
        background: linear-gradient(135deg, #781722, #a13a4d);
        color: white;
        padding: 0.65rem 1.4rem;
        border-radius: 9999px;
        font-size: 1.1rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(120, 23, 34, 0.2);
        white-space: nowrap;
    }

    .tag-item:hover {
        transform: translateY(-4px) scale(1.05);
        background: linear-gradient(135deg, #a13a4d, #781722);
        box-shadow: 0 10px 25px rgba(120, 23, 34, 0.35);
    }

    /* Responsive */
    @media (max-width: 640px) {
        .tag-item {
            padding: 0.55rem 1.1rem;
            font-size: 1rem;
        }
    }
</style>
