---
// src/components/CategoryTags.astro
import { getCollection } from "astro:content";

const allPosts = await getCollection("blogCollection");

// === LẤY TẤT CẢ TAGS (Server-side) ===
const allTags = new Set<string>();
allPosts.forEach((post) => {
    post.data.tags?.forEach((tag) => allTags.add(tag));
});

// Chuyển thành mảng và sắp xếp A-Z
const tagsArray = Array.from(allTags).sort((a, b) => a.localeCompare(b));
---

<div id="category-tags" class="max-w-360 mx-auto px-4 py-8">
    <div class="text-center mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-[#781722]">
            Thẻ Danh Mục
        </h1>
        <p class="text-gray-600 mt-2">
            Khám phá các sản phẩm theo danh mục ngẫu nhiên
        </p>
    </div>

    <!-- 1. Danh sách ẩn để JavaScript đọc dữ liệu -->
    <div id="all-tags-data" class="hidden">
        {
            tagsArray.map((tag) => (
                <span class="tag-data" data-tag={tag.toLowerCase()}>
                    {tag}
                </span>
            ))
        }
    </div>

    <!-- 2. Container hiển thị tags ngẫu nhiên -->
    <div
        id="tags-display"
        class="flex flex-wrap justify-center gap-3 md:gap-4 min-h-30"
    >
        <!-- JavaScript sẽ render vào đây -->
    </div>
</div>

<script>
    // Thuật toán Fisher-Yates Shuffle - Ngẫu nhiên tốt nhất
    function shuffleArray<T>(array: T[]): T[] {
        const shuffled = [...array]; // Tạo bản sao để không sửa mảng gốc
        for (let i = shuffled.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }
        return shuffled;
    }

    document.addEventListener("DOMContentLoaded", () => {
        const dataContainer = document.getElementById("all-tags-data");
        const displayContainer = document.getElementById("tags-display");

        if (!dataContainer || !displayContainer) return;

        // Lấy tất cả tags từ HTML ẩn
        const tagElements = dataContainer.querySelectorAll(".tag-data");

        const tags = Array.from(tagElements)
            .map((el) => ({
                name: el.textContent?.trim() || "",
                slug: el.getAttribute("data-tag") || "",
            }))
            .filter((tag) => tag.name !== "");

        // Shuffle và lấy tối đa 15 tags
        const shuffledTags = shuffleArray(tags).slice(0, 15);

        // Xóa nội dung cũ và render tags mới
        displayContainer.innerHTML = "";

        shuffledTags.forEach((tag) => {
            const link = document.createElement("a");
            link.href = `/tags/${tag.slug}`;
            link.className = "tag-item";
            link.textContent = `#${tag.name}`;
            displayContainer.appendChild(link);
        });
    });
</script>

<style is:global>
    .tag-item {
        display: inline-flex;
        align-items: center;
        background: linear-gradient(135deg, #781722, #a13a4d);
        color: white;
        padding: 0.65rem 1.4rem;
        border-radius: 9999px;
        font-size: 1.1rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(120, 23, 34, 0.2);
        white-space: nowrap;
        cursor: pointer;
    }

    .tag-item:hover {
        transform: translateY(-4px) scale(1.05);
        background: linear-gradient(135deg, #a13a4d, #781722);
        box-shadow: 0 10px 25px rgba(120, 23, 34, 0.35);
    }

    /* Responsive */
    @media (max-width: 640px) {
        .tag-item {
            padding: 0.55rem 1.1rem;
            font-size: 1rem;
        }
    }
</style>
