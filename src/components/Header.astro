---
import "../styles/global.css";
import MenuDynamics from "../layouts/MenuDynamics.astro";
import { Image } from "astro:assets";
---

<div class="flex-col max-w-10/10" id="container-head">
    <div id="header" class="flex-col items-center">
        <!-- Top bar -->
        <div class="header">
            <ul
                class="flex flex-row-reverse justify-start place-items-center py-2 items-center"
            >
                <div
                    id="abbutton"
                    class="py-[.5] grow flex justify-end basis-1/3"
                >
                    <div
                        class="px-4 py-[0.2]
                        bg-linear-95 from-red-400 to-red-200
                        rounded-2xl border-[0.05rem] border-solid text-center"
                    >
                        <a href="/about" class="text-xl my-1 text-center"
                            >Về chúng tôi<a
                                id="head-goodtext"
                                class="text-xl my-1">(GOOD)!</a
                            ></a
                        >
                    </div>
                </div>
                <div id="li-hai" class="pl-1">
                    <pre class="inline">CSKH: </pre><div
                        id="link-social"
                        class="inline"
                    >
                        <a target="_blank" href="https://zalo.me/0907335245"
                            >0907 335 245</a
                        >
                    </div><pre
                        class="inline"><a id="head-goodtext"> | </a></pre><br
                        id="head-br"
                    /><pre class="onlyCom">Hotline KD: </pre><div
                        id="link-social"
                        class="inline-block"
                    >
                        <a href="https://zalo.me/0789471752" target="_blank"
                            >0789 47 17 52</a
                        >
                    </div><pre class="inline"> – </pre><div
                        id="link-social"
                        class="inline-block"
                    >
                        <a target="_blank" href="https://zalo.me/0775964752"
                            >0775 96 47 52</a
                        >
                    </div><pre class="inline"> – </pre><div
                        id="link-social"
                        class="inline-block"
                    >
                        <a target="_blank" href="https://zalo.me/0901036457"
                            >0901 036 457</a
                        >
                    </div>
                </div>
            </ul>
        </div>
        <div
            class="bg-[#78172220] menu-header flex flex-row flex-wrap place-items-center"
        >
            <!-- Tiêu đề logo -->
            <div class="goodTitle flex flex-row grow items-center">
                <a href="/" class="goodlogo p-3 inline">
                    <img
                        src="/good.png"
                        alt="In ấn bao bì Cần Thơ"
                        width="75px"
                    />
                </a>

                <a href="/" class="goodtitle inline grow">
                    <img
                        src="/good-title.png"
                        alt="In ấn bao bì Good Lộc Phát"
                        width="150px"
                    />
                </a>
            </div>
            <!-- menu-header -->
            <div
                id="div-search"
                class="grow place-content-center h-auto w-auto"
            >
                <!-- Thanh tìm kiếm -->
                <input
                    class="rounded-[3rem]"
                    id="MenuSearch"
                    type="text"
                    placeholder="Tìm dịch vụ, sản phẩm"
                />
            </div>

            <div class="sloganDiv grid grid-cols-2 mx-auto">
                <card
                    class="sloganCard items-center flex align-middle p-3 col-span1"
                >
                    <p>Bao bì túi giấy đẹp<br /> in trọn gói tại 1 nơi</p>
                </card>
                <card
                    class="sloganCard items-center flex align-middle p-3 col-span-1"
                >
                    <p>Thiết kế đẹp<br /> Tư vấn nhiệt Tình</p>
                </card>
            </div>
        </div>
    </div>
    <MenuDynamics />
</div>

<style>
    .goodTitle a img {
        width: 8rem;
    }
    .goodTitle .goodtitle img {
        width: 18rem !important;
    }
    .onlyMobile {
        display: none;
    }
    .onlyCom {
        display: block;
    }
    #head-goodtext {
        display: content;
    }
    #head-br {
        display: none;
    }
    #div-search {
        margin-left: 15px;
        width: 21.875rem;
    }
    card {
    }
    .sloganDiv {
        //width: 20vw;
    }
    .sloganCard {
        width: 10rem;
    }
    #MenuSearch[type="text"] {
        float: right;
        padding: 0.5rem;
        padding-left: 1rem;
        border: none;
        margin-top: 0.5rem;
        margin-right: 0.5rem;
        font-size: 1.05rem;
        background-color: aliceblue;
        margin: 0.625rem;
        right: 0;
        max-lines: 1;
        height: 2.5rem;
        width: 21.875rem;
    }
    #abbutton {
    }
    #header {
        display: flex;
        justify-content: center;
    }
    .header {
        background-color: #11060c;
        padding: 5px;
        width: 1440px;
        max-width: 100%;
        color: aliceblue;
        margin-bottom: 1rem;
    }
    .menu-header {
        width: 1440px;
        max-width: 100%;
    }
    /*Strip the ul of padding and list styling*/
    ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
    }
    /*Create a horizontal list with spacing*/
    li {
        padding-left: 5px;
        padding-right: 5px;
        float: left;
        margin-right: 1px;
        font-size: 1rem;
        height: 100%;
    }
    ul li {
        height: 100%;
    }
    pre {
        display: inline-block;
    }
    #container-head {
        font-family:
            Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
            sans-serif;
        align-items: center;
    }
    #link-social {
        transition: all 0.55s;
    }
    #link-social:hover {
        -ms-transform: scale(3.45);
        /* IE 9 */
        -webkit-transform: scale(1.125);
        /* Safari 3-8 */
        transform: scale(1.125);
        cursor: pointer;
        color: #781722;
        background-color: #dfb4b9;
        padding: 3pt;
        border-radius: 8px;
    }
    @media screen and (max-width: 600px) {
        .goodTitle a img {
            width: 8rem;
        }
        .goodTitle .goodtitle img {
            width: 45vh !important;
        }
        .onlyMobile {
            display: inline-block;
        }
        .onlyCom {
            display: none;
        }
        .goodTitle {
            width: 100%;
            display: flex;
            flex-direction: row;
            align-items: center;
        }
        .goodlogo img {
            width: 100%;
        }
        .goodtitle img {
            width: 100%;
            padding-right: 1rem;
        }
        #MenuSearch[type="text"] {
            width: auto;
            min-width: 100%;
            overflow: hidden;
        }
        .header > ul {
            display: flex;
            flex-direction: column;
            -ms-flex-direction: column;
        }
        .header > ul > li {
        }
        p,
        a,
        pre {
            font-size: 0.8rem;
            display: inline-block;
        }
        #head-goodtext {
            display: none;
        }
        #head-br {
            display: block;
        }
        #abbutton {
            width: fit-content;
            height: fit-content;
            right: 0.65rem;
            display: flex;
            position: absolute;
            margin-top: 0;
        }
        #li-hai {
            width: 100%;
        }
        li a {
        }
        #div-search {
        }
        #MenuSearch[type="text"] {
            left: 0;
            display: flex;
            position: static;
            //padding: 0;
            margin: 0;
        }
        .sloganDiv {
            display: flex;
        }
        .sloganCard {
            background: #ededed;
            background: linear-gradient(
                148deg,
                rgba(237, 237, 237, 0.5) 0%,
                rgba(255, 255, 255, 0.5) 50%,
                rgba(186, 186, 186, 0.5) 100%
            );
            width: auto;
            padding-top: 0.3rem;
            padding-bottom: 0.3rem;
            margin: 0.8rem 0.3rem 0.5rem 0.3rem;
            border-radius: 1rem;
        }
        .sloganCard p {
            font-size: 0.9rem !important;
            color: #781722;
            font-weight: 600 !important;
            text-align: center;
            line-height: 1.35rem;
        }
    }
</style>
