---
// src/components/Footer.astro
import { ArrowBigRightDash, BaggageClaim } from "@lucide/astro";
import ImgCTam from "../assets/salers/ctam.png";
import ImgCTruyen from "../assets/salers/ctruyen.png";
import ImgThu from "../assets/salers/thu.png";
---

<footer class="bg-[#781722] text-white">
    <div class="max-w-360 mx-auto">
        <!-- Top Bar - Dark background -->
        <div class="bg-[#5c1420] border-b-4 border-[#781722]">
            <div class="px-2 lg:px-3 pt-2 pb-8">
                <!-- Inbox Button -->
                <div
                    id="ibnow"
                    class="inline-flex items-center gap-3
                    bg-linear-to-r from-red-800 to-red-600 text-white
                    px-3 py-2
                    rounded-2xl border border-red-300-200
                    hover:scale-105 transition-transform
                    cursor-pointer shadow-xl"
                >
                    <BaggageClaim size={34} />
                    <h5 class="text-xl font-semibold flex items-center gap-2">
                        INBOX NGAY
                        <ArrowBigRightDash
                            size={22}
                            class="transition-transform"
                        />
                    </h5>
                </div>

                <!-- Hotlines - Giữ nguyên style gốc -->
                <ul
                    id="hotline"
                    class="flex flex-wrap justify-center gap-6 mt-8"
                >
                    <li class="hotline-item">
                        <img
                            src={ImgCTam.src}
                            class="h-20 rounded-[60px] bg-orange-100"
                            alt="Chị Tâm"
                        />
                        <p
                            class="hotlinecard inline-block p-3 pr-5 rounded-r-4xl border-y border-r border-orange-200 translate-x-[-0.8rem]"
                        >
                            Hotline:
                            <a href="https://zalo.me/0789471752" target="_blank"
                                >0789 47 17 52</a
                            ><br class="onlyMobile" />
                            (Thu Tâm in ấn Good)
                        </p>
                    </li>

                    <li class="hotline-item">
                        <img
                            src={ImgCTruyen.src}
                            class="h-20 rounded-[60px] bg-orange-100"
                            alt="Chị Truyền"
                        />
                        <p
                            class="hotlinecard inline-block p-3 pr-5 rounded-r-4xl border-y border-r border-orange-200 translate-x-[-0.8rem]"
                        >
                            Hotline:
                            <a href="https://zalo.me/0775964752" target="_blank"
                                >0775 96 47 52</a
                            ><br class="onlyMobile" />
                            (Truyền in ấn GOOD)
                        </p>
                    </li>

                    <li class="hotline-item">
                        <img
                            src={ImgThu.src}
                            class="h-20 rounded-[60px] bg-orange-100"
                            alt="chị Thư"
                        />
                        <p
                            class="hotlinecard inline-block p-3 pr-5 rounded-r-4xl border-y border-r border-orange-200 translate-x-[-0.8rem]"
                        >
                            Hotline:
                            <a href="https://zalo.me/0901036457" target="_blank"
                                >0901 036 457</a
                            ><br class="onlyMobile" />
                            (Good In Ấn Bao Bì Túi Giấy)
                        </p>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Social & Address -->
        <div class="px-4 lg:px-8 py-10 bg-[#781722]">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                <!-- Social -->
                <div>
                    <h3 class="text-xl font-semibold mb-6">
                        Kết nối với chúng tôi
                    </h3>
                    <ul class="social space-y-4 text-lg">
                        <li>
                            <img
                                src="../ico-footer/facebook.png"
                                width="22px"
                                style="display: inline"
                            />
                            <a>Fanpage: </a><a
                                id="link-social"
                                target="_blank"
                                href="https://www.facebook.com/inanbaobicantho"
                                >In ấn bao bì Cần Thơ
                            </a>
                        </li>
                        <li>
                            <img
                                src="../ico-footer/tik-tok.png"
                                width="22px"
                                style="display: inline"
                            />
                            <a>Tiktok: </a><a
                                id="link-social"
                                target="_blank"
                                href="https://www.tiktok.com/@locphat1210?is_from_webapp=1&sender_device="
                                >Good in ấn bao bì Cần Thơ</a
                            >
                        </li>
                        <li>
                            <img
                                src="../ico-footer/shopee.png"
                                width="22px"
                                style="display: inline"
                            />
                            <a>Shopee: </a><a
                                id="link-social"
                                target="_blank"
                                href="https://vn.shp.ee/NBJcLCE"
                                >Good - In ấn bao bì</a
                            >
                        </li>
                        <li>
                            <img
                                src="../ico-footer/shopee.png"
                                width="22px"
                                style="display: inline"
                            />
                            <a>Shopee: </a><a
                                id="link-social"
                                target="_blank"
                                href="https://vn.shp.ee/PCXxUHn"
                                >LỘC PHÁT - BAO BÌ BẠC LIÊU</a
                            >
                        </li>
                        <li>
                            <img
                                src="../ico-footer/shopee.png"
                                width="22px"
                                style="display: inline"
                            />
                            <a>Shopee: </a><a
                                id="link-social"
                                target="_blank"
                                href="https://vn.shp.ee/sECwMnF"
                                >bao bì - túi giấy</a
                            >
                        </li>
                        <li>
                            <img
                                src="../ico-footer/zalo.png"
                                width="22px"
                                style="display: inline"
                            />
                            <a>Tham gia ngay </a><a
                                id="link-social"
                                target="_blank"
                                href="https://zalo.me/g/dztqfp388"
                                >nhóm khách sỉ nhận ưu đãi</a
                            >
                        </li>
                    </ul>
                </div>

                <!-- Address -->
                <div class="addressFoot mb-16 pb-4 border-b border-dashed p-4">
                    <h3 class="text-xl font-semibold mb-6">Liên hệ</h3>
                    <p class="text-2xl font-bold mb-4">
                        Hotline KT: <a
                            href="https://zalo.me/0907335245"
                            target="_blank">0907 335 245</a
                        >
                    </p>
                    <p class="text-lg leading-relaxed">
                        📍 KDC Hoàng Phát, Số 6, Đường Huỳnh Thị Đê,<br />
                        Phường Bạc Liêu, TP. Bạc Liêu
                    </p>
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
    #ibnow:hover {
        transform: scale(1.08);
    }

    .addressFoot p {
        color: #fff;
    }

    .hotline-item {
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s;
    }

    .hotline-item:hover {
        transform: translateY(-4px);
    }

    .hotline-item p {
        font-size: 1.35rem;
        font-weight: 500;
        color: #fff;
        margin: 0;
    }

    .hotline-item a {
        color: #ffeb3b;
        font-weight: 700;
    }
    .hotlinecard {
        padding-top: 0.3rem;
        padding-bottom: 0.3rem;
        border-radius: 1rem;
    }
    .hotline-item a:hover {
        color: white;
        text-decoration: underline;
    }

    /* Bo góc dưới + Đổ bóng 3D */
    footer > div {
        border-bottom-left-radius: 30px;
        border-bottom-right-radius: 30px;
        box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.4);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .hotline-item {
            flex-direction: column;
            text-align: center;
            gap: 8px;
            padding: 0 !important;
        }

        .hotline-item p {
            font-size: 1.2rem;
        }

        .hotlinecard {
            border-radius: 1rem;
            border: solid 0.1rem;
            margin: 0 !important;
            transform: translateX(0.8rem);
            padding-bottom: 0.3rem;
            padding-top: 0.2rem;
        }
    }
</style>
