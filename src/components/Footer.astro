---
// src/components/Footer.astro
import { ArrowBigRightDash, BaggageClaim } from "@lucide/astro";
import ImgCTam from "../assets/salers/ctam.png";
import ImgCTruyen from "../assets/salers/ctruyen.png";
import ImgThu from "../assets/salers/thu.png";
---

<footer class="bg-[#781722] text-white">
    <div class="max-w-[1440px] mx-auto">
        <!-- Top Bar - Dark background -->
        <div class="bg-[#5c1420] border-b-4 border-[#781722]">
            <div class="px-4 lg:px-8 pt-6 pb-8">
                <!-- Inbox Button -->
                <div
                    id="ibnow"
                    class="inline-flex items-center gap-3 bg-gradient-to-r from-red-800 to-red-600 text-white px-6 py-4 rounded-2xl border-2 border-orange-200 hover:scale-105 transition-transform cursor-pointer shadow-xl"
                >
                    <BaggageClaim size={34} />
                    <h5 class="text-xl font-semibold flex items-center gap-2">
                        INBOX NGAY
                        <ArrowBigRightDash
                            size={22}
                            class="transition-transform"
                        />
                    </h5>
                </div>

                <!-- Hotlines - Giữ nguyên style gốc -->
                <ul
                    id="hotline"
                    class="flex flex-wrap justify-center gap-6 mt-8"
                >
                    <li class="hotline-item">
                        <img
                            src={ImgCTam.src}
                            class="h-20 rounded-[60px] bg-orange-100"
                            alt="Chị Tâm"
                        />
                        <p
                            class="inline-block p-3 pr-5 rounded-r-2xl border-y border-r border-orange-200 bg-[#781722]"
                        >
                            Hotline:
                            <a href="https://zalo.me/0789471752" target="_blank"
                                >0789 47 17 52</a
                            >
                        </p>
                    </li>

                    <li class="hotline-item">
                        <img
                            src={ImgCTruyen.src}
                            class="h-20 rounded-[60px] bg-orange-100"
                            alt="Chị Truyền"
                        />
                        <p
                            class="inline-block p-3 pr-5 rounded-r-2xl border-y border-r border-orange-200 bg-[#781722]"
                        >
                            Hotline:
                            <a href="https://zalo.me/0775964752" target="_blank"
                                >0775 96 47 52</a
                            >
                        </p>
                    </li>

                    <li class="hotline-item">
                        <img
                            src={ImgThu.src}
                            class="h-20 rounded-[60px] bg-orange-100"
                            alt="Chị Thu"
                        />
                        <p
                            class="inline-block p-3 pr-5 rounded-r-2xl border-y border-r border-orange-200 bg-[#781722]"
                        >
                            Hotline:
                            <a href="https://zalo.me/0901036457" target="_blank"
                                >0901 036 457</a
                            >
                        </p>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Social & Address -->
        <div class="px-4 lg:px-8 py-10 bg-[#781722]">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
                <!-- Social -->
                <div>
                    <h3 class="text-xl font-semibold mb-6">
                        Kết nối với chúng tôi
                    </h3>
                    <ul class="social space-y-4 text-lg">
                        <li>📘 Fanpage: In ấn bao bì Cần Thơ</li>
                        <li>🎵 Tiktok: Good in ấn bao bì Cần Thơ</li>
                        <li>🛒 Shopee: Good - In ấn bao bì</li>
                        <li>🛒 Shopee: LỘC PHÁT - BAO BÌ BẠC LIÊU</li>
                        <li>🛒 Shopee: Bao bì - Túi giấy</li>
                        <li>💬 Nhóm Zalo: Khách sỉ nhận ưu đãi</li>
                    </ul>
                </div>

                <!-- Address -->
                <div>
                    <h3 class="text-xl font-semibold mb-6">Liên hệ</h3>
                    <p class="text-2xl font-bold mb-4">
                        Hotline KT: <a
                            href="https://zalo.me/0907335245"
                            target="_blank">0907 335 245</a
                        >
                    </p>
                    <p class="text-lg leading-relaxed">
                        📍 KDC Hoàng Phát, Số 6, Đường Huỳnh Thị Đê,<br />
                        Phường Bạc Liêu, TP. Bạc Liêu
                    </p>
                </div>
            </div>
        </div>
    </div>
</footer>

<style>
    #ibnow:hover {
        transform: scale(1.08);
    }

    .hotline-item {
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s;
    }

    .hotline-item:hover {
        transform: translateY(-4px);
    }

    .hotline-item p {
        font-size: 1.35rem;
        font-weight: 500;
        color: #fff;
        margin: 0;
    }

    .hotline-item a {
        color: #ffeb3b;
        font-weight: 700;
    }

    .hotline-item a:hover {
        color: white;
        text-decoration: underline;
    }

    /* Bo góc dưới + Đổ bóng 3D */
    footer > div {
        border-bottom-left-radius: 30px;
        border-bottom-right-radius: 30px;
        box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.4);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .hotline-item {
            flex-direction: column;
            text-align: center;
            gap: 8px;
        }

        .hotline-item p {
            font-size: 1.2rem;
        }
    }
</style>
