---
interface Props {
    date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
    {
        date.toLocaleDateString("vi-VN", {
            weekday: "long",
            year: "numeric",
            month: "short",
            day: "numeric",
            timeZone: "Asia/Ho_Chi_Minh",
        })
    }
</time>
