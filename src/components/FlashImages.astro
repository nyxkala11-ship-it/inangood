---
// src/components/FlashImages.astro
interface Props {
    class?: string;
}

const { class: className = "" } = Astro.props;

import { Image } from "astro:assets";
import video from "../assets/banner/video.mp4";
import Banner1 from "../assets/banner/1.jpg";
import Banner2 from "../assets/banner/2.jpg";
import Banner3 from "../assets/banner/3.jpg";
import Banner4 from "../assets/banner/4.jpg";
---

<div class={`flash-section w-full ${className}`}>
    <div class="max-w-360 mx-auto max-md:px-2 max-md:rounded">
        <!-- Flash Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-7 gap-4 lg:gap-6">
            <!-- Video chính - lg:col-span-4 -->
            <div
                class="lg:col-span-4 rounded-3xl overflow-hidden shadow-2xl aspect-4/3 md:aspect-square lg:aspect-4/3"
            >
                <video
                    class="w-full h-full object-cover"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    controls
                >
                    <source src={video} type="video/mp4" />
                    Trình duyệt không hỗ trợ video.
                </video>
            </div>

            <!-- 4 ảnh phụ - lg:col-span-3 -->
            <div class="lg:col-span-3 grid grid-cols-2 gap-2 lg:gap-4">
                <div
                    class="rounded-xl overflow-hidden aspect-square shadow-md hover:scale-[1.04] transition-transform duration-300"
                >
                    <Image
                        src={Banner1}
                        alt="In Ấn Good - Sản phẩm 1"
                        class="w-full h-full object-cover"
                        loading="lazy"
                        widths={[400, 600, 800]}
                    />
                </div>
                <div
                    class="rounded-xl overflow-hidden aspect-square shadow-md hover:scale-[1.04] transition-transform duration-300"
                >
                    <Image
                        src={Banner2}
                        alt="In Ấn Good - Sản phẩm 2"
                        class="w-full h-full object-cover"
                        loading="lazy"
                        widths={[400, 600, 800]}
                    />
                </div>
                <div
                    class="rounded-xl overflow-hidden aspect-square shadow-md hover:scale-[1.04] transition-transform duration-300"
                >
                    <Image
                        src={Banner3}
                        alt="In Ấn Good - Sản phẩm 3"
                        class="w-full h-full object-cover"
                        loading="lazy"
                        widths={[400, 600, 800]}
                    />
                </div>
                <div
                    class="rounded-xl overflow-hidden aspect-square shadow-md hover:scale-[1.04] transition-transform duration-300"
                >
                    <Image
                        src={Banner4}
                        alt="In Ấn Good - Sản phẩm 4"
                        class="w-full h-full object-cover"
                        loading="lazy"
                        widths={[400, 600, 800]}
                    />
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .flash-section {
        font-feature-settings:
            "kern" 1,
            "liga" 1;
    }

    /* Video luôn cover đầy khung */
    video {
        object-fit: cover;
    }
</style>
