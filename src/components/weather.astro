---
export const prerender = false;

const city = "Bac Lieu";
let weatherText = "Đang tải...";
let iconWeather = "🌦️"; // Icon mặc định
let error = false;

try {
    const weatherUrl = `https://wttr.in/${encodeURIComponent(city)}?format=j1`;

    const response = await fetch(weatherUrl, {
        headers: {
            "User-Agent": "Mozilla/5.0 (compatible; Astro/1.0)",
        },
        cache: "no-store",
    });

    if (!response.ok) throw new Error();

    const data = await response.json();

    const area = data.nearest_area?.[0]?.areaName?.[0]?.value || "BẠC LIÊU";
    const temp = data.current_condition?.[0]?.temp_C || "--";
    const desc =
        data.current_condition?.[0]?.lang_vi?.[0]?.value ||
        data.current_condition?.[0]?.weatherDesc?.[0]?.value ||
        "";

    // Lấy icon (wttr.in trả về URL icon)
    const iconUrl = data.current_condition?.[0]?.weatherIconUrl?.[0]?.value;

    weatherText = `${area}: ${temp}°C`; // ${desc}

    if (iconUrl) {
        iconWeather = iconUrl; // Đây là URL ảnh
    }
} catch (e) {
    console.error("Weather error:", e);
    weatherText = "❌ Lỗi lấy dữ liệu thời tiết";
    error = true;
}
---

<div class="TERM-CONTAINER flex flex-col max-sm:flex-row items-center gap-2">
    <img
        src={iconWeather}
        alt="weather icon"
        width="38"
        height="38"
        class="block rounded-xl sticky"
    />
    <p class={`text-[.6rem] font-bold ${error ? "text-red-500" : ""}`}>
        {weatherText.toUpperCase()}
    </p>
</div>
