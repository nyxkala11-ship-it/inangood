---
// src/components/MaterialSec.astro  (hoặc LýDoChonXuong.astro)
import {
    Zap,
    Tags,
    BaggageClaim,
    Brush,
    TruckElectric,
    ShieldCheck,
    TicketCheck,
    PrinterCheck,
} from "@lucide/astro";
---

<div id="title" class="relative max-w-360 mx-auto px-1 lg:px-0 mt-2">
    <!-- Title đỏ -->
    <div id="title-red" class="bg-linear-180 from-[#ed7485ff] to-[#df0824ff]">
        <p>
            <Zap size={25} class="inline-block align-middle" />
            7 LÝ DO KHÁCH CHỌN XƯỞNG
        </p>
    </div>

    <!-- Backdrop Grid -->
    <div
        id="backdrop"
        class="flex flex-row flex-wrap
        md:grid-cols-3 lg:grid-cols-5
        gap-1 lg:gap-6
        justify-between"
    >
        <div class="group">
            <div class="item-inner">
                <Tags size={30} class="mx-auto text-[#781722]" />
                <h1>CHẤT LIỆU CAO CẤP</h1>
                <p>Giấy dày dặn, in sắC nét</p>
            </div>
        </div>

        <div class="group">
            <div class="item-inner">
                <BaggageClaim size={30} class="mx-auto text-[#781722]" />
                <h1>ĐỘI NGŨ CHUYÊN NGHIỆP</h1>
                <p>Tư vấn nhiệt tình, tận tâm</p>
            </div>
        </div>

        <div class="group">
            <div class="item-inner">
                <ShieldCheck size={30} class="mx-auto text-[#781722]" />
                <h1>CAM KẾT CHẤT LƯỢNG</h1>
                <p>
                    Đúng mẫu, giá tốt<br />
                    Lỗi 1 đổi 1
                </p>
            </div>
        </div>

        <div class="group">
            <div class="item-inner">
                <Brush size={30} class="mx-auto text-[#781722]" />
                <h1>MIỄN PHÍ THIẾT KẾ</h1>
                <p>Đến khi ưng ý</p>
            </div>
        </div>

        <div class="group">
            <div class="item-inner">
                <TicketCheck size={30} class="mx-auto text-[#781722]" />
                <h1>NHẬN IN SỐ LƯỢNG ÍT</h1>
                <p>Linh hoạt, tiết kiệm chi phí</p>
            </div>
        </div>

        <div class="group">
            <div class="item-inner">
                <PrinterCheck size={30} class="mx-auto text-[#781722]" />
                <h1>HỖ TRỢ IN NHANH</h1>
                <p>
                    Cho khách cần gấp<br />
                    Có hàng trong ngày
                </p>
            </div>
        </div>

        <div class="group">
            <div class="item-inner">
                <TruckElectric size={30} class="mx-auto text-[#781722]" />
                <h1>GIAO HÀNG TOÀN QUỐC</h1>
                <p></p>
            </div>
        </div>
    </div>
</div>

<style>
    #title {
        width: 1440px;
        max-width: 100%;
    }

    #title-red {
        z-index: 2;
        color: aliceblue;
        padding: 0.3rem 0.6rem;
        border-radius: 15px 15px 15px 0px;
        display: inline-block;
        line-height: 1.8rem;
        font-weight: 600;
        font-size: 1rem;
    }

    #backdrop {
        border: 3px solid #781722;
        backdrop-filter: blur(20px);
        background-color: rgba(255, 255, 255, 0.25);
        padding: 0.85rem;
        border-radius: 0px 25px 25px 25px;
    }

    .item-inner {
        text-align: center;
        padding: 0.5rem;
        border-radius: 12px;
        height: 100%;
        transition: all 0.4s ease;
    }

    .group:hover .item-inner {
        background-color: rgb(255, 255, 255);
        transform: translateY(-8px);
    }

    .item-inner h1 {
        font-size: 1rem;
        font-weight: 700;
        color: #781722;
        margin: 1rem 0 0.5rem;
    }

    .item-inner p {
        font-size: 0.75rem;
        color: #444;
        line-height: 1.2;
    }

    /* Hover scale cho title */
    .group:hover .item-inner h1 {
        transform: scale(1.12);
        transition: transform 0.4s;
    }

    /* ==================== RESPONSIVE ==================== */
    @media screen and (max-width: 1024px) {
        #backdrop {
            padding: 1.4rem 1rem;
        }
    }

    @media screen and (max-width: 640px) {
        #title-red {
            font-size: 1rem;
            padding: 0.2rem 0.95rem;
        }

        .item-inner h1 {
            font-size: 0.75rem;
        }

        .item-inner p {
            font-size: 0.5rem;
        }
    }
</style>
