        background-size: cover;
        aspect-ratio: 4.118;
        box-sizing: border-box;
        height: 5rem;
        transition: all 0.35s;
    }

    .nut:hover {
        transform: translateX(-0.8rem) scale(1.1);
        cursor: pointer;
    }

    .nut p {
        line-height: 1.5;
    }

    .lucideIcon {
        width: 2.5rem;
        height: 2.5rem;
        color: #ffffff;
    }

    .lucideIconFoot {
        width: 3rem;
        height: 3rem;
        padding: 0.5rem;
        border: 0.1rem solid gray;
        color: rgba(255, 252, 251, 1);
        border-radius: 2rem;
    }

    .nutIconRed {
        background-image: url('data:image/svg+xml,<%3Fxml version="1.0" encoding="UTF-8" standalone="no"%3F><!-- Created with Inkscape (http://www.inkscape.org/) --><svg width="12.868136mm" height="12.911821mm" viewBox="0 0 12.868136 12.911821" version="1.1" id="svg1" xml:space="preserve" inkscape:export-batch-name="batchicon-color" inkscape:export-batch-path="D:\resources\DkyWeb\svgs" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape" xmlns:sodipodi="http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg"><sodipodi:namedview id="namedview1" pagecolor="%23ffffff" bordercolor="%23000000" borderopacity="0.25" inkscape:showpageshadow="2" inkscape:pageopacity="0.0" inkscape:pagecheckerboard="0" inkscape:deskcolor="%23d1d1d1" inkscape:document-units="mm"><inkscape:page x="0" y="0" width="12.868136" height="12.911821" id="page1" margin="0" bleed="0" /></sodipodi:namedview><defs id="defs1"><linearGradient id="linearGradient132" inkscape:collect="always"><stop style="stop-color:%23ed7485;stop-opacity:1;" offset="0" id="stop132" /><stop style="stop-color:%23df0824;stop-opacity:1;" offset="1" id="stop133" /></linearGradient><filter style="color-interpolation-filters:sRGB" inkscape:label="Drop Shadow" id="filter126" x="-0.21997823" y="-0.22140676" width="1.4743281" height="1.4889399"><feFlood result="flood" in="SourceGraphic" flood-opacity="0.231373" flood-color="rgb(0,0,0)" id="feFlood125" /><feGaussianBlur result="blur" in="SourceGraphic" stdDeviation="0.800000" id="feGaussianBlur125" /><feOffset result="offset" in="blur" dx="0.300000" dy="0.400000" id="feOffset125" /><feComposite result="comp1" operator="in" in="flood" in2="offset" id="feComposite125" /><feComposite result="comp2" operator="over" in="SourceGraphic" in2="comp1" id="feComposite126" /></filter><linearGradient inkscape:collect="always" xlink:href="%23linearGradient132" id="linearGradient133