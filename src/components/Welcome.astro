    }
    .nutIconGreen {
        background-image: url('data:image/svg+xml,<%3Fxml version="1.0" encoding="UTF-8" standalone="no"%3F><!-- Created with Inkscape (http://www.inkscape.org/) --><svg width="12.868105mm" height="12.911821mm" viewBox="0 0 12.868105 12.911821" version="1.1" id="svg1" xml:space="preserve" inkscape:export-batch-name="batchicon-color" inkscape:export-batch-path="D:\resources\DkyWeb\svgs" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape" xmlns:sodipodi="http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg"><sodipodi:namedview id="namedview1" pagecolor="%23ffffff" bordercolor="%23000000" borderopacity="0.25" inkscape:showpageshadow="2" inkscape:pageopacity="0.0" inkscape:pagecheckerboard="0" inkscape:deskcolor="%23d1d1d1" inkscape:document-units="mm"><inkscape:page x="0" y="0" width="12.868105" height="12.911821" id="page1" margin="0" bleed="0" /></sodipodi:namedview><defs id="defs1"><linearGradient id="linearGradient141" inkscape:collect="always"><stop style="stop-color:%2345bc75;stop-opacity:1;" offset="0" id="stop140" /><stop style="stop-color:%23307d5f;stop-opacity:1;" offset="1" id="stop141" /></linearGradient><filter style="color-interpolation-filters:sRGB" inkscape:label="Drop Shadow" id="filter126-6" x="-0.21997904" y="-0.22140676" width="1.4743298" height="1.4889399"><feFlood result="flood" in="SourceGraphic" flood-opacity="0.231373" flood-color="rgb(0,0,0)" id="feFlood125-8" /><feGaussianBlur result="blur" in="SourceGraphic" stdDeviation="0.800000" id="feGaussianBlur125-57" /><feOffset result="offset" in="blur" dx="0.300000" dy="0.400000" id="feOffset125-6" /><feComposite result="comp1" operator="in" in="flood" in2="offset" id="feComposite125-1" /><feComposite result="comp2" operator="over" in="SourceGraphic" in2="comp1" id="feComposite126-8" /></filter><linearGradient inkscape:collect="always" xlink:href="%23linearGradient141" id="line