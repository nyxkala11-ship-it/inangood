---
// src/components/IntroSection.astro
import Material from "../components/Material.astro";
import Slide from "../components/Slide.astro";
import MaterialSec from "../components/MaterialSec.astro";

import { CircleCheckBig, Layers, ClockCheck, Printer } from "@lucide/astro";
---

<div class="flex flex-col items-center" id="container">
    <main class="w-full">
        <div id="intro">
            <p id="XI">BAO BÌ</p>
            <h1 id="intro-title">TÚI GIẤY KRAFT</h1>

            <div id="red-intro">
                <p>GIÁ GỐC - NHẬN TỪ 50 TÚI</p>
            </div>

            <p id="intro-h2">CÓ HÀNG TRONG NGÀY</p>

            <!-- Benefits - 1 cột dọc, icon + text inline -->
            <div id="intro-list-contain" class="mt-10 space-y-6">
                <div class="benefit-item">
                    <CircleCheckBig
                        size={52}
                        class="text-[#781722] flex-shrink-0"
                    />
                    <p>Cần in túi giấy để kịp bán hàng</p>
                </div>

                <div class="benefit-item">
                    <Printer size={52} class="text-[#781722] flex-shrink-0" />
                    <p>
                        Xưởng in trực tiếp - làm nhanh, lấy liền, không cần số
                        lượng lớn.
                    </p>
                </div>

                <div class="benefit-item">
                    <Layers size={52} class="text-[#781722] flex-shrink-0" />
                    <p>
                        Chỉ từ 50 túi, bạn đã có túi giấy in logo riêng - phù
                        hợp shop mới, bán online hoặc test thị trường.
                    </p>
                </div>

                <div class="benefit-item">
                    <ClockCheck
                        size={52}
                        class="text-[#781722] flex-shrink-0"
                    />
                    <p>
                        Ngoài ra, xưởng nhận in trọn bộ: Hóa đơn, tem nhãn, tag
                        treo, voucher, menu, bao bì đóng gói → giúp bạn có bộ
                        nhận diện đồng bộ.
                    </p>
                </div>
            </div>
        </div>
    </main>

    <Material />
    <div class="block m-5"></div>
    <MaterialSec />
    <div class="block m-5"></div>
    <Slide />
    <div class="block m-5"></div>
</div>

<style>
    main {
        height: 100%;
        display: flex;
        justify-content: flex-start;
        max-width: 1440px; /* === Đúng yêu cầu 1440px === */
        margin: 0 auto;
        background-image: url("../assets/intro/advicesbackground.png");
        background-size: auto 100%;
        background-repeat: no-repeat;
        background-position: right;
        padding: 2.5rem 2.5rem 5rem;
    }

    #intro {
        max-width: 620px;
        width: 100%;
    }

    /* Style gốc */
    #XI {
        color: #717171;
        font-size: 2rem;
        font-weight: 600;
    }

    #intro-title {
        color: #781722 !important;
        font-size: 6rem !important;
        font-family: Tahoma, sans-serif !important;
        font-weight: 800;
        line-height: 5.4rem !important;
        margin-bottom: 0.8rem;
    }

    #red-intro {
        background-color: #781722;
        padding: 5px;
        margin-top: 1.2rem;
        border-radius: 20px;
        display: inline-block;
    }

    #red-intro p {
        color: white;
        padding: 0.9rem 1.4rem;
        font-size: 2rem;
        margin: 0;
    }

    #intro-h2 {
        font-size: 2rem !important;
        color: #781722 !important;
        margin-top: 1rem;
        margin-bottom: 2rem;
    }

    /* Benefit Item - Icon + Text inline */
    .benefit-item {
        display: flex;
        align-items: flex-start;
        gap: 1.4rem;
        padding: 0.6rem 0;
    }

    .benefit-item p {
        margin: 0;
        line-height: 1.65;
        font-size: 1.15rem;
        color: #2c2e30;
    }

    /* ==================== MOBILE ==================== */
    @media screen and (max-width: 768px) {
        main {
            padding: 1.8rem 1.2rem 4rem;
            background-size: cover;
            background-position: center;
        }

        #intro-title {
            font-size: 4rem !important;
            line-height: 3.8rem !important;
        }

        #red-intro p {
            font-size: 1.65rem !important;
            padding: 0.75rem 1.2rem;
        }

        #intro-h2 {
            font-size: 1.6rem !important;
        }

        /* Glass Blur chỉ trên mobile */
        .benefit-item {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.65);
            border-radius: 16px;
            padding: 1.3rem 1.5rem;
        }

        .benefit-item p {
            font-size: 1.08rem;
        }
    }
</style>
