---
// src/components/IntroSection.astro
import Material from "../components/Material.astro";
import Slide from "../components/Slide.astro";
import MaterialSec from "../components/MaterialSec.astro";
import Flash from "../components/FlashImages.astro";

import {
    Atom,
    BadgeDollarSign,
    CircleCheckBig,
    Clover,
    FilePenLine,
    Gift,
    Headset,
    PencilLine,
    PencilRuler,
    ShieldCheck,
    ThumbsUp,
    Truck,
} from "@lucide/astro";
---

<div class="flex flex-col items-center" id="container">
    <main class="w-full flex flex-col">
        <div id="" class="w-full flex flex-col items-center h-full">
            <p
                id="xuongin"
                class="text-center w-fit px-7 py-0 mt-3 mb-0
                text-3xl font-bold
                rounded-4xl bg-linear-180 from-[#f33788ff] to-[#cd0c58ff]
                text-white"
            >
                XƯỞNG IN
            </p>
            <div
                id="intro-title"
                class="drop-shadow-[1_0.5rem_0.1rem_rgba(0,0,255,0.8)]"
            >
                <h1
                    class="pt-2
                bg-linear-180 from-[#2964d5ff] to-[#00185dff]
                bg-clip-text text-transparent
                text-center
                /*
                Source - https://stackoverflow.com/a/74753353
                Posted by Philipp John, modified by community. See post 'Timeline' for change history
                Retrieved 2026-05-30, License - CC BY-SA 4.0
                */
                drop-shadow-[0.1rem_0.1rem_0.1rem_rgba(255,255,255,1)]"
                >
                    BAO BÌ - TÚI GIẤY
                </h1>
            </div>
            <div id="intro-title">
                <h2
                    class="pt-3
                    bg-linear-180 from-[#f23379ff] to-[#cd0c58ff]
                    bg-clip-text text-transparent text-center
                    /*
                    Source - https://stackoverflow.com/a/74753353
                    Posted by Philipp John, modified by community. See post 'Timeline' for change history
                    Retrieved 2026-05-30, License - CC BY-SA 4.0
                    */
                    drop-shadow-[0.1rem_0.1rem_0.1rem_rgba(255,255,255,1)]"
                >
                    TEM NHÃN GIÁ XƯỞNG
                </h2>
            </div>
            <div
                id="linead"
                class="text-center w-fit px-8 my-2
            rounded-4xl bg-linear-180 from-[#2964d5ff] to-[#00185dff]
            font-bold
            text-white"
            >
                <p>THIẾT KẾ VÀ IN TRỌN GÓI TẠI 1 NƠI</p>
            </div>

            <!-- Danh sách -->
            <div
                class="flex flex-row-reverse
                w-full h-full mx-auto max-xl:grid
                max-xl:content-end max-xl:mb-3"
            >
                <div class="slogan flex justify-end max-xl:pt-3">
                    <p
                        class="slogan
                    font-sans
                    max-md:pb-1
                    mr-4"
                    >
                        Bao bì đẹp - Thương hiệu mạnh - Khách hàng nhớ lâu 💕
                    </p>
                </div>
                <div
                    class="benefits justify-start
                    w-full
                    md:ml-5
                    max-md:translate-y-1 max-xl:flex-wrap
                    max-xl:flex max-xl:flex-row
                    max-md:w-full max-xl:justify-around
                    max-md:content-end"
                >
                    <div class="nut flex flex-row justify-start items-center">
                        <div class="nutIcon nutIconRed p-6 pl-5">
                            <CircleCheckBig
                                class="text-[#ffffff] font-bold shrink-0 lucideIcon"
                            />
                        </div>
                        <p class="nutText inline font-bold text-[#e63c51ff]">
                            <strong>IN SỐ LƯỢNG ÍT</strong><br />VẪN NHẬN
                        </p>
                    </div>
                    <div class="nut flex flex-row justify-start items-center">
                        <div class="nutIcon nutIconOrange p-6 pl-5">
                            <FilePenLine
                                class="text-[#ffffff] font-bold shrink-0 lucideIcon"
                            />
                        </div>
                        <p class="nutText inline font-bold text-[#f7720bff]">
                            <strong>THIẾT KẾ</strong><br />THEO YÊU CẦU RIÊNG
                        </p>
                    </div>
                    <div class="nut flex flex-row justify-start items-center">
                        <div class="nutIcon nutIconGreen p-6 pl-5">
                            <Gift
                                class="text-[#ffffff] font-bold shrink-0 lucideIcon"
                            />
                        </div>
                        <p class="nutText inline font-bold text-[#307d5fff]">
                            <strong>MẪU MÃ ĐA DẠNG</strong><br />NHIỀU NGÀNH
                            HÀNG
                        </p>
                    </div>
                    <div class="nut flex flex-row justify-start items-center">
                        <div class="nutIcon nutIconBlue p-6 pl-5">
                            <BadgeDollarSign
                                class="text-[#ffffff] font-bold shrink-0 lucideIcon"
                            />
                        </div>
                        <p class="nutText inline font-bold text-[#037ed8ff]">
                            <strong>GIÁ XƯỞNG TẬN NƠI</strong><br />KHÔNG QUA
                            TRUNG GIAN
                        </p>
                    </div>
                    <div class="nut flex flex-row justify-start items-center">
                        <div class="nutIcon nutIconPurple p-6 pl-5">
                            <PencilRuler
                                class="text-[#ffffff] font-bold shrink-0 lucideIcon"
                            />
                        </div>
                        <p class="nutText inline font-bold text-[#852cd1ff]">
                            <strong>HỖ TRỢ CHỈNH SỬA</strong><br />ĐẾN KHI ƯNG
                        </p>
                    </div>
                    <div class="nut flex flex-row justify-start items-center">
                        <div class="nutIcon nutIconPink p-6 pl-5">
                            <Truck
                                class="text-[#ffffff] font-bold shrink-0 lucideIcon"
                            />
                        </div>
                        <p class="nutText inline font-bold text-[#ed1577ff]">
                            <strong>GIAO HÀNG NHANH</strong><br />TOÀN QUỐC
                        </p>
                    </div>
                </div>
            </div>

            <!-- Benefits - 1 cột dọc, icon + text inline
            <div id="intro-list-contain" class="mt-10 space-y-6">
                <div class="benefit-item">
                    <CircleCheckBig size={52} class="text-[#781722] shrink-0" />
                    <p>Cần in túi giấy để kịp bán hàng</p>
                </div>

                <div class="benefit-item">
                    <Printer size={52} class="text-[#781722] shrink-0" />
                    <p>
                        Xưởng in trực tiếp - làm nhanh, lấy liền, không cần số
                        lượng lớn.
                    </p>
                </div>

                <div class="benefit-item">
                    <Layers size={52} class="text-[#781722] shrink-0" />
                    <p>
                        Chỉ từ 50 túi, bạn đã có túi giấy in logo riêng - phù
                        hợp shop mới, bán online hoặc test thị trường.
                    </p>
                </div>

                <div class="benefit-item">
                    <ClockCheck size={52} class="text-[#781722] shrink-0" />
                    <p>
                        Ngoài ra, xưởng nhận in trọn bộ: Hóa đơn, tem nhãn, tag
                        treo, voucher, menu, bao bì đóng gói → giúp bạn có bộ
                        nhận diện đồng bộ.
                    </p>
                </div>
            </div>
             -->
        </div>
        <div
            id="splash-footer"
            class="flex content-center justify-around xl:py-2"
        >
            <card class="flex content-center items-center hidden">
                <div class="">
                    <PencilLine
                        class="lucideIconFoot py-3 max-md:p-0 bg"
                        stroke-width={2}
                    />
                </div>
                <div>
                    <p class="text-white">NHẬN THIẾT KẾ - IN ẤN</p>
                    <h3 class="text-white font-bold">THEO YÊU CẦU</h3>
                </div>
            </card>
            <card class="flex flex-row items-center">
                <div class="">
                    <ThumbsUp
                        class="lucideIconFoot p-3 max-md:p-0"
                        stroke-width={2}
                    />
                </div>
                <div>
                    <p class="text-white">CÔNG NGHỆ HIỆN ĐẠI</p>
                    <h3 class="text-white font-bold">SẮC NÉT - CHUẨN MÀU</h3>
                </div>
            </card>
            <card class="flex flex-row items-center">
                <div class="p-3 max-xl:p-0">
                    <ShieldCheck class="lucideIconFoot" stroke-width={2} />
                </div>
                <div>
                    <p class="text-white">CHẤT LIỆU GIẤY CAO CẤP</p>
                    <h3 class="text-white font-bold">THÂN THIỆN MÔI TRƯỜNG</h3>
                </div>
            </card>
            <card class="flex flex-row items-center">
                <div class="p-3 max-md:p-0">
                    <Headset class="lucideIconFoot" stroke-width={2} />
                </div>
                <div>
                    <p class="text-white">ĐỘI NGŨ TƯ VẤN</p>
                    <h3 class="text-white font-bold">
                        NHIỆT TÌNH - CHUYÊN NGHIỆP
                    </h3>
                </div>
            </card>
        </div>
    </main>

    <Material />
    <MaterialSec />
    <Flash />
    <Slide />
</div>

<style is:global>
    .slogan {
        font-family: var(--font-fleur-de-leah);
        font-size: 1.8rem;
        color: #022565;
        line-height: 2.2rem;
    }
    .nut {
