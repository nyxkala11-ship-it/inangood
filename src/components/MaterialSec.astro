---
// src/components/MaterialSec.astro
import { getCollection } from "astro:content";
const materials = await getCollection("materialTwoColection");
---

<div id="title" class="max-w-360 mx-auto px-2 lg:px-0 mt-2">
    <!-- Title đỏ nổi bật -->
    <div
        id="title-red"
        class="rounded-2xl rounded-bl-none
    bg-linear-180 from-[#ed7485ff] to-[#df0824ff]"
    >
        <p>IN ẤN THEO YÊU CẦU ĐA DẠNG CÁC SẢN PHẨM</p>
    </div>

    <!-- Backdrop Grid -->
    <div
        id="backdrop"
        class="rounded-2xl
        grid grid-cols-2 mx-auto
        md:grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-6"
    >
        {
            materials.map((mater) => (
                <div class="group">
                    <div class="item-inner rounded-lg">
                        <h1>{mater.data.title}</h1>
                        <p>{mater.data.description}</p>
                        {mater.data.image !== "none" && (
                            <img
                                src={mater.data.image}
                                class="mx-auto mt-3 w-[200] h-[300] rounded"
                            />
                        )}
                        {mater.data.video !== "none" && (
                            <video
                                autoplay
                                controls
                                class="mx-auto mt-3 w-[200] h-[300] rounded"
                            >
                                <source src={mater.data.video} />
                            </video>
                        )}
                    </div>
                </div>
            ))
        }
    </div>

    <style>
        #title {
            width: 1440px;
            max-width: 100%;
        }

        #title-red {
            z-index: 2;
            position: relative;
            color: aliceblue;
            padding: 0.3rem 0.6rem;
            display: inline-block;
            line-height: 1.8rem;
            font-weight: 600;
            font-size: 1rem;
            transform: translateY(0.8rem);
        }

        #backdrop {
            border: 0.1rem solid #781722;
            backdrop-filter: blur(50px);
            background-color: rgba(255, 255, 255, 0.25);
            padding: 1.5rem 1.25rem;
            z-index: -1;
        }

        .item-inner {
            text-align: center;
            padding: 0.2rem 0.5rem;
            height: 100%;
            transition: all 0.25s ease;
            cursor: pointer;
        }

        .group:hover .item-inner {
            background-color: rgba(255, 255, 255, 0.95);
            transform: translateY(-6px);
        }

        .item-inner h1 {
            font-size: 1.25rem;
            font-weight: 700;
            color: #781722;
            margin: 0.1rem 0 0.4rem;
        }

        .item-inner p {
            font-size: 0.95rem;
            color: #444;
            line-height: 1.45;
        }

        /* Hover scale icon + text */
        .group:hover .item-inner h1 {
            transform: scale(1.08);
            transition: transform 0.4s;
        }

        /* ==================== RESPONSIVE ==================== */
        @media screen and (max-width: 1024px) {
            #backdrop {
                padding: 1.25rem 1rem;
            }
        }

        @media screen and (max-width: 640px) {
            #title-red {
                font-size: 1rem;
                padding: 0.2rem 0.95rem;
            }

            .item-inner h1 {
                font-size: 1.1rem;
            }

            .item-inner p {
                font-size: 0.9rem;
            }
        }
    </style>
</div>
