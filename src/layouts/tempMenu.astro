<style is:global>
.menu-container {
  width: 100%;
  margin-top: 10px;
  border-radius: 5px;
}

.main-menu {
  max-width: 1440px;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  list-style: none;
  margin: 0;
  padding: 0;
}

.menu-item {
  position: relative;
  padding: 6pt 1.5rem 6pt 6pt;
}

.menu-item a {
  font-size: 1.3rem;
  text-decoration: none;
  color: inherit;
}

.menu-item:hover {
  background-color: aliceblue;
  transition: 0.35s;
}

.dropdown-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  background-color: aliceblue;
  padding: 15px;
  border-radius: 5px;
  min-width: 240px;
  list-style: none;
  margin: 0;
  z-index: 999;
}

.has-dropdown:hover .dropdown-menu {
  display: block;
  margin-top: 7px;
}

.dropdown-menu li {
  padding: 8px 0;
}

.dropdown-menu li a {
  font-size: 1rem;
}

/* Mobile styles */
.menu-mobile-btn {
  display: none;
}

@media screen and (max-width: 600px) {
  .menu-mobile-btn {
    display: block;
    width: 100%;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
  }
  
  .main-menu {
    display: none;
    flex-direction: column;
  }
  
  .main-menu.active {
    display: flex;
  }
  
  .menu-item {
    width: 100%;
  }
  
  .dropdown-menu {
    position: static;
    display: none;
    padding-left: 20px;
  }
  
  .has-dropdown.active .dropdown-menu {
    display: block;
  }
}


