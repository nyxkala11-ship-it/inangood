<!-- Component Menu -->
<div class="menu-container flex flex-cols justify-center">
  <button id="menuMobileBtn" class="menu-mobile-btn">
    <LogsIcon size="32" class="inline" />
    <span class="pl-2">Menu</span>
  </button>

  <ul id="mainMenu" class="main-menu">
    <li class="menu-item">
      <a href="/">Trang chủ</a>
    </li>
    
    {rootMenus.map(menuitem => (
    <li class={`menu-item ${menuitem.children.length > 0 ? 'has-dropdown' : ''}`}>
        <a href={menuitem.slug}>{menuitem.title}</a>
        
        {menuitem.children.length > 0 && (
        <ul class="dropdown-menu">
            {menuitem.children.map(child => (
            <li >
                <a href={child.slug}>{child.title}</a>
            </li>
            ))}
        </ul>
        )}
    </li>
    ))}
  </ul>
</div>

