// Xây dựng cấu trúc cây menu
interface MenuItem {
  id: string;
  title: string;
  slug: string;
  index: number;
  category: string;
  children: MenuItem[];
}

// Map tra cứu nhanh
const productMap = new Map<string, MenuItem>();
// Tạo map catergory
const categoryMap = new Map<string, MenuItem>();
const sortedProducts = [...allProducts].sort((a, b) => {
    // Nếu cả hai đều có index, sort theo index tăng dần
   
        console.log('srt tăng dần');
        return a.data.index - b.data.index;
});

console.log('=== SORTED: Index items first, then no-index ===');
sortedProducts.forEach((product, i) => {
    const index = product.data.index;
    console.log(`${i + 1}. ${product.data.title} - Index: ${index || 'NO INDEX'}`);
});
//const slide = await getCollection('slide');
// Debug từng item - Xem cấu trúc đầy đủ
console.log('=== TOTAL PRODUCTS:', allProducts.length);
console.log('========================================');
// Tạo menu items cho parent (category)
sortedProducts.forEach(product => {
    if (product.data.parent === 'none') {
        const menuItem: MenuItem = {
            id: product.id,
            title: product.data.title,
            slug: `/products/${product.id}`,
            index: product.data.index,
            category: product.data.catergory,
            children: []
        };
        categoryMap.set(product.data.catergory, menuItem);
        productMap.set(product.id, menuItem);
    }
});


