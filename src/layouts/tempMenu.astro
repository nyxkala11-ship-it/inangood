/// đã lấy được

// Xây dựng cây menu
sortedProducts.forEach(product => {
    if (product.data.parent !== 'none') {
        const menuItem: MenuItem = {
            id: product.id,
            title: product.data.title,
            slug: `/products/${product.id}`,
            index: product.data.index,
            category: product.data.catergory,
            children: []
        };
        productMap.set(product.id, menuItem);
        
        // Tìm parent theo category
        const parentItem = categoryMap.get(product.data.parent);
        if (parentItem) {
            parentItem.children.push(menuItem);
            //console.log(`✅ Đã thêm "${menuItem.title}" vào parent "${parentItem.title}"`);
        } else {
            //console.log(`⚠️ Không tìm thấy parent category: "${product.data.parent}" cho child "${menuItem.title}"`);
        }
    }
});

// Lấy menu items gốc
