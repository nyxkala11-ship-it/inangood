---
import Layout from "./Layout.astro";
import Footer from "../components/Footer.astro";
import BaseHead from "../components/Header.astro";
import background from "../assets/background.svg";
import type { CollectionEntry } from "astro:content";
import FormattedDateAstroComponent from "../components/FormattedDate.astro";
import ImportMediaAstroComponent from "../components/importMedia.astro";
// Cấu hình Splide  -  yêu cầu npm install astro-splide @splidejs/splide-extension-auto-scroll

import type { Options } from "@splidejs/splide";
import "@splidejs/splide";
import Image from "astro/components/Image.astro";
import "@splidejs/splide";
import {
    ArrowBigLeftDash,
    ArrowBigRight,
    ArrowBigRightDash,
} from "@lucide/astro";
import { getCollection, render } from "astro:content";
type Props = CollectionEntry<"blogCollection">["data"];
const { title, date, catergory, parent, id, images, videos } = Astro.props;
const allProducts = await getCollection("blogCollection");
const itemsMap = new Map<string, CatergoryItem>();
interface CatergoryItem {
    id: string;
    title: string;
    slug: string;
    index: number;
}

allProducts.forEach((element) => {
    if (element.data.parent === catergory) {
        const catergoryItem: CatergoryItem = {
            id: element.data.id,
            title: element.data.title,
            slug: `/products/${element.data.id}`,
            index: element.data.index,
        };
        itemsMap.set(element.data.title, catergoryItem);
    }
});

export interface PropsImg {
    imagePath: string;
    altText: string;
    name: string;
    age: number;
}

const option: Options = {
    type: "loop",
    drag: "free",
    focus: "center",
    perPage: 1,
    autoScroll: {
        speed: 1,
    },
};

const RootCatList = Array.from(catergory);

// Xử lý ngày tháng năm
function formatToVietnameseDate(dateInput: string | Date): string {
    const date = new Date(dateInput);

    // Return early if the date is invalid
    if (isNaN(date.getTime())) return "Ngày không hợp lệ";

    const formatter = new Intl.DateTimeFormat("vi-VN", {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "Asia/Ho_Chi_Minh",
    });

    return formatter.format(date);
}
// ==================== XỬ LÝ ASSETS ====================
const getAssets = () => {
    const rawImgAssets = import.meta.glob("./**/**/*.{jpg,png,svg,webp}", {
        eager: true,
    });

    const rawVidAssets = import.meta.glob("./**/**/*.mp4", {
        eager: true,
        query: "?url",
        import: "default",
    });

    return { rawImgAssets, rawVidAssets };
};

const assets = getAssets();

// Xử lý ảnh và video - trả về URL đúng
const processedImages = images?.map((imgName) => {
    if (imgName === "none") return "none";

    for (const [path, module] of Object.entries(assets.rawImgAssets)) {
        if (path.includes(imgName) || path.endsWith(imgName)) {
            return (module as any).default || module; // Đảm bảo lấy URL
        }
    }
    return imgName;
});

const processedVideos = videos?.map((vidName) => {
    if (vidName === "none") return "none";

    for (const [path, module] of Object.entries(assets.rawVidAssets)) {
        if (path.includes(vidName) || path.endsWith(vidName)) {
            return module;
        }
    }
    return vidName;
});

const mainVideo = processedVideos?.[0] || null;
const previewImages = processedImages?.slice(0, 10) || [];

---

<Layout>
    <BaseHead />
        <main class="flex flex-col items-center w-full my-15">
            <div class="text-2xl p-4" id="container">
                <p>Danh mục: {parent === "none" ? catergory : parent}</p>
                {}
                <div class="flex flex-col items-start mt-12 mb-8">
                {
                  allProducts.filter(element => element.data.parent === catergory).map(element =>
                  <a href=`/products/${element.data.id}` class="
                  bg-[#78172210]
                  p-6 m-2 pl-8
                  w-full
                  mx-auto
                  text-left
                  shadow-xl shadow-olive-300
                  transition-all
                  hover:shadow-xs hover:shadow-olive-400 hover:translate-y-0.75
                  rounded-2xl
                  border-zinc-100 border
                  caterogy
                  ">
                      {element.data.title}
                  </a>
                  )}
                </div>
                <!-- Preview + Form -->
                <div
                    id="desimg"
                    class="flex flex-col gap-12 w-full max-w-6xl mx-auto mb-12"
                >
                    <!-- PREVIEW -->
                    <div class="flex flex-col gap-6">
                        <!-- Video -->
                        {
                            mainVideo && mainVideo !== "none" && (
                                <div class="w-full aspect-video bg-black rounded-3xl overflow-hidden shadow-2xl">
                                    <ImportMediaAstroComponent
                                        productId={id}
                                        mediaName={mainVideo}
                                        type="video"
                                    />
                                </div>
                            )
                        }

                        <!-- Grid ảnh -->
                        <div>
                            <p class="text-lg font-medium text-gray-900 mb-4">
                                Hình ảnh chi tiết sản phẩm
                            </p>
                            <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
                                {
                                    previewImages.map(
                                        (img, index) =>
                                            img !== "none" && (
                                                <div class="aspect-square rounded overflow-hidden border border-gray-700 hover:border-violet-500 transition-all duration-300">
                                                    <ImportMediaAstroComponent
                                                        productId={id}
                                                        mediaName={img}
                                                        type="image"
                                                    />
                                                </div>
                                            ),
                                    )
                                }
                            </div>
                        </div>
                    </div>

                    <!-- CHỌN QUY CÁCH -->
                    <div class="p-8 rounded-3xl border border-gray-700">
                        <form id="formQuyCach" action="" class="space-y-8">


                            <input
                                type="submit"
                                value="Đặt túi ngay !"
                                class="mt-4 w-full py-5 bg-linear-to-r from-[#781722] to-[#a13a4d] text-white font-bold text-xl rounded-2xl hover:brightness-110 active:scale-[0.98] transition-all cursor-pointer"
                                onclick=""
                                />
                        </form>
                    </div>
                </div>
                <!-- Phần mô tả -->
                <div
                    id="description"
                    class="text-center leading-12 border border-sky-100 rounded-3xl p-8"
                >
                    <img
                        id="background"
                        src={background.src}
                        alt=""
                        fetchpriority="high"
                    />

                    <div
                        class="mx-auto
                        text-left
                    MardownContent flex flex-col lg:max-w-[55vw]"
                    >
                        <slot />
                    </div>
                    <div id="desdate" class="text-[.8rem] pb-2">
                        <p>Cập nhật ngày: {formatToVietnameseDate(date)}</p>
                    </div>
                </div>
            </div>
        </main>
    </body>

    <Footer />
</Layout>

<style is:global>

    * {
        font-size: 55;
    }
    #background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: -1;
        filter: blur(100px);
    }

    .mySlides {
        display: none;
        position: absolute;
        height: 100%;
    }

    .displaySlide {
        display: block;
    }

    #container {
        font-family:
            Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
            sans-serif;
        width: 1440px;
        max-width: 100%;
        height: 100%;
        margin-top: 2vh;
    }

    #links {
        display: flex;
        gap: 16px;
    }

    #links a {
        display: flex;
        align-items: center;
        padding: 10px 12px;
        color: #111827;
        text-decoration: none;
        transition: color 0.2s;
    }

    #links a:hover {
        color: rgb(78, 80, 86);
    }

    #links a svg {
        height: 1em;
        margin-left: 8px;
    }

    #links a.button {
        color: white;
        background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
        box-shadow:
            inset 0 0 0 1px rgba(255, 255, 255, 0.12),
            inset 0 -2px 0 rgba(0, 0, 0, 0.24);
        border-radius: 10px;
    }

    #preview {
        position: relative;
    }

    .button {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
    }

    .previousbtn {
        left: 0;
    }
    .nextbtn {
        right: 0;
    }

    #links a.button:hover {
        color: rgb(230, 230, 230);
        box-shadow: none;
    }

    h2 {
        font-weight: normal;
        color: #111827;
        font-size: 20px;
    }


    img {
        display: flex;
        justify-self: center;
    }

    code {
        display: inline-block;
        background:
            linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
            linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%)
                border-box;
        border-radius: 8px;
        border: 1px solid transparent;
        padding: 6px 8px;
    }

    .MarKdownContentc {
        background-color: #bc52ee !important;
    }

    .MarKdownContentc img {
        width: 50%;
        margin: 1.5rem auto;
        border-radius: 12px;
    }

    .MarKdownContentc p,
    .MarKdownContentc a,
    .MarKdownContentc li {
        text-align: left;
        font-size: 1.2rem;
        padding-bottom: 0.2rem;
    }

    .MarkdownContentc h1 {
        margin-bottom: 5rem;
        font-size: 2rem;
    }

    .MarKdownContentc h2 {
        font-size: 1.8rem;
        font-weight: 500;
    }

    .MarKdownContentc h3 {
        font-size: 1.5rem;
        font-weight: 500;
        color: lightcoral;
    }
    .MarKdownContentc hr {
        border: 0.1rem darkviolet;
        border-style: dashed none none none;
        margin-top: 2rem !important;
        margin-bottom: 2rem !important;
        width: 60%;
        height: 1rem;
        margin: auto;
    }

    @media screen and (max-height: 368px) {
        #news {
            display: none;
        }
    }
    @media screen and (max-width: 768px) {
        #container {
            display: flex;
            flex-direction: column;
        }

        #hero {
            display: block;
            padding-top: 10%;
        }

        #links {
            flex-wrap: wrap;
        }

        #links a.button {
            padding: 14px 18px;
        }

        #news {
            right: 16px;
            left: 16px;
            bottom: 2.5rem;
            max-width: 100%;
        }

        h1 {
            line-height: 1.5;
        }

        .MarKdownContentc p {
            font-size: 1rem;
            max-width: 100vw;
        }
    }
    @media screen and (max-width: 600px) {
        #desimg {
            display: flex;
            flex-direction: column;
        }
    }
</style>

<script>
    const slides = document.querySelectorAll(".mySlides");
    let slideIndex = 0;
    let intervalId: null | ReturnType<typeof setInterval> = null;

    let nextbtn = document.getElementById("nextbtn");
    let prebtn = document.getElementById("prebtn");
    // initializeSlider()
    document.addEventListener("DOMContentLoaded", initializeSlider);

    function initializeSlider() {
        if (slides.length > 0) {
            slides[slideIndex].classList.add("displaySlide");
            intervalId = setInterval(nextSlide, 5000);
        }
    }

    nextbtn!.onclick = function () {
        nextSlide();
    };
    prebtn!.onclick = function () {
        prevSlide();
    };

    function showSlide(index) {
        if (index >= slides.length) {
            slideIndex = 0;
        } else if (index < 0) {
            slideIndex = slides.length - 1;
        }

        slides.forEach((slide) => {
            slide.classList.remove("displaySlide");
        });
        slides[slideIndex].classList.add("displaySlide");
    }

    function prevSlide() {
        slideIndex--;
        showSlide(slideIndex);
    }

    function nextSlide() {
        slideIndex++;
        showSlide(slideIndex);
    }
</script>
