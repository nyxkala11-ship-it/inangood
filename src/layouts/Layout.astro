---
import { ArrowBigUpDash } from "@lucide/astro";
import "../styles/global.css";
import { Font } from "astro:assets";
import backgrounds from "../assets/backgrounds.svg";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- -->
        <link rel="icon" type="image/svg+xml" href="/favicongood.png" />
        <!--svg-->
        <link rel="icon" type="image/x-icon" href="/favicongood.ico" />
        <!--ico-->
        <meta name="generator" content="In ấn GOOD" />
        <!--{Astro.generator}-->
        <title>In Ấn GOOD</title>
        <!-- Fonts -->
        <Font cssVariable="--font-nunito" />
    </head>
    <body>
        <img id="background" src={backgrounds.src} />
        <slot />
        <button onclick="topFunction()" id="topbutton" title="Go to top"
            ><ArrowBigUpDash size={38} /></button
        >
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: auto;

        padding-left: 0.2rem;
        padding-right: 0.2rem;

        display: grid;
        grid-template-rows: auto 1fr auto;
        grid-template-columns: 100%;

        /* fallback height */
        min-height: 100vh;

        /* new small viewport height for modern browsers */
        min-height: 100svh;

        /*background-color: #f7f4ef;*/
    }
    #topbutton {
        display: none; /* Hidden by default */
        position: fixed; /* Fixed/sticky position */
        bottom: 0.8rem; /* Place the button at the bottom of the page */
        right: 0.5rem; /* Place the button 30px from the right */
        z-index: 999; /* Make sure it does not overlap */
        border: 0.15rem solid #d6b0b073; /* Remove borders */
        outline: none; /* Remove outline */
        background-color: #700f1a58; /* Set a background color */
        backdrop-filter: blur(0.5rem);
        color: white; /* Text color */
        cursor: pointer; /* Add a mouse pointer on hover */
        padding: 0.5rem; /* Some padding */
        border-radius: 3rem; /* Rounded corners */
        font-size: 0.6rem; /* Increase font size */
        margin: 0.45rem;
    }

    #topbutton:hover {
        background-color: #6e2a2a; /* Add a dark-grey background on hover */
    }

    #background {
        position: fixed;
        top: 0;
        left: 0;
        z-index: -1;
        width: auto;
        height: auto;
        filter: blur(3rem);
        transform: scale(1.1);
        overflow: hidden;
    }

    @media screen and (max-width: 768px) {
        html,
        body {
            padding-left: 0rem !important;
            padding-right: 0rem !important;
        }
    }
</style>

<script>
    //import Topbut from "../scripts/topbutscripts";

    // Get the button:
    let mybutton = document.getElementById("topbutton");

    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () {
        scrollFunction();
    };

    function scrollFunction() {
        if (
            document.body.scrollTop > 20 ||
            document.documentElement.scrollTop > 20
        ) {
            mybutton!.style.display = "block";
        } else {
            mybutton!.style.display = "none";
        }
    }
    mybutton!.onclick = function () {
        topFunction();
    };
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
        console.log("on Top");
    }
</script>
