---
import { ArrowBigUpDash } from "@lucide/astro";
import "../styles/global.css";
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- -->
        <link rel="icon" type="image/svg+xml" href="/favicongood.png" />
        <!--svg-->
        <link rel="icon" type="image/x-icon" href="/favicongood.ico" />
        <!--ico-->
        <meta name="generator" content="In ấn GOOD" />
        <!--{Astro.generator}-->
        <title>In Ấn GOOD</title>
        <!-- Fonts -->
        <Font cssVariable="--font-fleur-de-leah" />
    </head>
    <body>
        <slot />
        <button onclick="topFunction()" id="topbutton" title="Go to top"
            ><ArrowBigUpDash size={38} /></button
        >
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: auto;

        padding-left: 0.2rem;
        padding-right: 0.2rem;

        display: grid;
        grid-template-rows: auto 1fr auto;
        grid-template-columns: 100%;

        /* fallback height */
        min-height: 100vh;

        /* new small viewport height for modern browsers */
        min-height: 100svh;

        /*background-color: #f7f4ef;*/
        background-image: url('data:image/svg+xml,<%3Fxml version="1.0" encoding="UTF-8" standalone="no"%3F><!-- Created with Inkscape (http://www.inkscape.org/) --><svg width="272.86063mm" height="672.44305mm" viewBox="0 0 272.86063 672.44305" version="1.1" id="svg1" xml:space="preserve" inkscape:export-batch-name="batchicon-color-background-page" inkscape:export-batch-path="D:\resources\DkyWeb\svgs" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape" xmlns:sodipodi="http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg"><sodipodi:namedview id="namedview1" pagecolor="%23ffffff" bordercolor="%23000000" borderopacity="0.25" inkscape:showpageshadow="2" inkscape:pageopacity="0.0" inkscape:pagecheckerboard="0" inkscape:deskcolor="%23d1d1d1" inkscape:document-units="mm"><inkscape:page x="0" y="0" width="272.86063" height="672.44305" id="page1" margin="0" bleed="0" /></sodipodi:namedview><defs id="defs1"><linearGradient id="linearGradient1915" inkscape:collect="always"><stop style="stop-color:%23d6e1fb;stop-opacity:1;" offset="0" id="stop1915" /><stop style="stop-color:%2383b4e3;stop-opacity:0.61627907;" offset="0.15000001" id="stop1917" /><stop style="stop-color:%23f7cde9;stop-opacity:1;" offset="0.27272728" id="stop1918" /><stop style="stop-color:%23d7eafd;stop-opacity:1;" offset="0.42207792" id="stop1919" /><stop style="stop-color:%23ecdef0;stop-opacity:1;" offset="0.58441561" id="stop1921" /><stop style="stop-color:%2376a3df;stop-opacity:1;" offset="0.75" id="stop1922" /><stop style="stop-color:%23c7d9f8;stop-opacity:1;" offset="0.87987012" id="stop1923" /><stop style="stop-color:%234e8ad6;stop-opacity:1;" offset="1" id="stop1916" /></linearGradient><linearGradient inkscape:collect="always" xlink:href="%23linearGradient1915" id="linearGradient1916" x1="-331.11179" y1="-131.98056" x2="-331.11179" y2="399.58243" gradientUnits="userSpaceOnUse" gradientTransform="matrix(1,0,0,1.3708334,0,-148.55746)" /></defs><g inkscape:label="Layer 1" inkscape:groupmode="layer" id="layer1" transform="translate(455.78967,271.83868)"><rect style="opacity:1;fill:url(%23linearGradient1916);stroke:none;stroke-width:0.415642;stroke-dasharray:1.66257, 0.831285" id="rect1915" width="272.86063" height="672.44305" x="-455.78967" y="-271.83868" rx="1" ry="1.3708333" /></g></svg>');
        background-size: cover;
    }
    #topbutton {
        display: none; /* Hidden by default */
        position: fixed; /* Fixed/sticky position */
        bottom: 0.8rem; /* Place the button at the bottom of the page */
        right: 0.5rem; /* Place the button 30px from the right */
        z-index: 999; /* Make sure it does not overlap */
        border: 0.15rem solid #d6b0b073; /* Remove borders */
        outline: none; /* Remove outline */
        background-color: #700f1a58; /* Set a background color */
        backdrop-filter: blur(0.5rem);
        color: white; /* Text color */
        cursor: pointer; /* Add a mouse pointer on hover */
        padding: 0.5rem; /* Some padding */
        border-radius: 3rem; /* Rounded corners */
        font-size: 0.6rem; /* Increase font size */
        margin: 0.45rem;
    }

    #topbutton:hover {
        background-color: #6e2a2a; /* Add a dark-grey background on hover */
    }
</style>

<script>
    //import Topbut from "../scripts/topbutscripts";

    // Get the button:
    let mybutton = document.getElementById("topbutton");

    // When the user scrolls down 20px from the top of the document, show the button
    window.onscroll = function () {
        scrollFunction();
    };

    function scrollFunction() {
        if (
            document.body.scrollTop > 20 ||
            document.documentElement.scrollTop > 20
        ) {
            mybutton!.style.display = "block";
        } else {
            mybutton!.style.display = "none";
        }
    }
    mybutton!.onclick = function () {
        topFunction();
    };
    // When the user clicks on the button, scroll to the top of the document
    function topFunction() {
        document.body.scrollTop = 0; // For Safari
        document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
        console.log("on Top");
    }
</script>
