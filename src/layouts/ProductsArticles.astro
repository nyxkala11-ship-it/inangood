---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/Header.astro'
import background from '../assets/background.svg';
import type { CollectionEntry } from "astro:content";
// Cấu hình Splide  -  yêu cầu npm install astro-splide @splidejs/splide-extension-auto-scroll

import type { Options } from '@splidejs/splide';
import "@splidejs/splide"
import { ArrowBigLeftDash, ArrowBigRight, ArrowBigRightDash } from '@lucide/astro';
import ImportMedia from '../components/importMedia.astro';

type Props = CollectionEntry<"blogCollection">["data"];
const { title, date, catergory, parent, id, images, videos } = Astro.props;

const currentPath = import.meta.url;

//const currentDir = new URL('.', currentPath).pathname;

// Lấy danh sách các file từ thư mục hiện tại
const getAssets = () => {
	// Sử dụng import tất car các file ảnh trong thư mục hiện tại
	const allAssets = import.meta.glob('./**/**/*.{jpg,png,svg,mp4,webm}', {
		eager: true,
		query: '?url',
		import: 'default'
	});

	// hoacwj raw
	const rawImgAssets = import.meta.glob('./**/**/*.{jpg,png,svg,webm}', {
		eager: true,
	});

	// hoacwj raw
	const rawVidAssets = import.meta.glob('./**/**/*.mp4', {
		eager: true,
		query: '?url',
		import: 'default'
	});

	return {allAssets, rawImgAssets, rawVidAssets};
};

const assets = getAssets();

const processedImages = images?.map(imgName => {
	if (imgName === 'none') return 'none';

	// timf file anhr trong thuw mucj hieenj taij
	for (const [path, module] of Object.entries(assets.rawImgAssets)) {
		if (path.includes(imgName) || path.endsWith(imgName)) {
			return module;
		}
	}
	return imgName;
});

const processedVideos = videos?.map(vidName => {
	if (vidName === 'none') return 'none';

	// timf file anhr trong thuw mucj hieenj taij
	for (const [path, module] of Object.entries(assets.rawVidAssets)) {
		if (path.includes(vidName) || path.endsWith(vidName)) {
			return module;
		}
	}
	return vidName;
});

export interface PropsImg {
   imagePath: string;
   altText: string;
   name: string;
   age: number;
}

const option: Options = {
    type: 'loop',
    drag: 'free',
    focus: 'center',
    perPage: 1,
    autoScroll: {
        speed: 1,
    },
}


console.log(images);
