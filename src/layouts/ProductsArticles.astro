---
<Layout>
	<BaseHead />
    <body>
		<main class="flex flex-col items-center w-full" >
			<div class="text-2xl pt-2" id="container">
				<div class="bg-gray-900 catName mb-1">
				    <p>Danh mục: {parent === "none" ? catergory : parent} </p>
				</div>
				<div id="desimg" class="grid grid-cols-2 mb-3">
					<div id="preview" class="col-span-1 flex items-center justify-center">
							{processedVideos?.map(img =>
							(img !== "none") &&
							<ImportMedia productId={id} mediaName=`${img}` type="video" />
								//<video width="500" height="500" class="mySlides aspect-square" controls>
								// 	<source style="object-fit: fill; aspect-square" src=`${img}`>
								//</video>
							)}

							{processedImages?.map(img =>
							(img === "none") ? <div class="none">&nbsp;</div> :
							//<!-- change image to img  -->
							<ImportMedia productId={id} mediaName=`${img}` type="image" />
								//<img loading="lazy" class="mySlides aspect-square" src=`${img}` alt="" height={500} width={500} />
							)}
							<button id="nextbtn" onclick="nextSlide()" class="button previousbtn flex items-center py-3 text-white hover:bg-blue-400"><ArrowBigLeftDash size={55} /></button>

							<button id="prebtn" onclick="nextSlide()" class="button nextbtn flex items-center py-3 text-white hover:bg-blue-400"><ArrowBigRightDash size={55} /></button>

						<!---<slot /> -->
					</div>
					<div id="desselect" class="col-span-1 p-5">
						Chọn quy cách
						<div id="title" class=""><h1>{title}</h1></div>
						<br><br>
						<form action="#">
							<label for="Size">Chọn cỡ:</label>
							<select class="bg-white p-2 rounded-md border-1px border-black-200" name="kraft" id="kraft">
							<option value="20x10">Túi 20x10</option>
							<option value="20x20">Túi 20x20</option>
							<option value="16x16">Túi 16x16</option>
							</select>
							<br><br>
							<label for="Mau">Mẫu:</label>
							<select class="bg-white p-2 rounded-md border-1px border-black-200" name="mau" id="mau">
							<option value="cute01">Mẫu Cute 01</option>
							<option value="cute02">Mẫu Cute 02</option>
							<option value="cute03">Mẫu Cute 03</option>
							<option value="cute04">Mẫu Cute 04</option>
							<option value="cute05">Mẫu Cute 05</option>
							<option value="cute06">Mẫu Cute 06</option>
							<option value="cute07">Mẫu Cute 07</option>
							<option value="cute08">Mẫu Cute 08</option>
							</select>
							<br><br>
							<input class="flex items-center justify-center px-5 bg-linear-95 from-red-800 to-red-600 rounded-xl border-1px border-solid border-orange-200 float-left flex-row fg-white w-62.5" type="submit" value="Đặt túi !">
						</form>
					</div>
				</div>

				<div id="description" class="text-center leading-12 border-solid border-1px rounded-xl border-sky-100 p-5">
					<img id="background" src={background.src} alt="" fetchpriority="high" />
					<div id="desdate"><p>"Cập nhật ngày:" {date}</p></div>
					<!-- Slot cho content! -->
					<div class="MardownContent flex flex-col justify-center items-center">
					    <slot slot="content" />
					</div>
				</div>

			</div>
		</main>
	</body>

    <Footer />
</Layout>

