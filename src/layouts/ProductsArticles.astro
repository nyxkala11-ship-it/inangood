---
import Layout from "./Layout.astro";
import Footer from "../components/Footer.astro";
import BaseHead from "../components/Header.astro";
import background from "../assets/background.svg";
import type { CollectionEntry } from "astro:content";
import ImportMedia from "../components/importMedia.astro";

type Props = CollectionEntry<"blogCollection">["data"];

const {
    title,
    date,
    catergory,
    parent,
    id,
    images = [],
    videos = [],
} = Astro.props;

// Xử lý ngày tháng năm
function formatToVietnameseDate(dateInput: string | Date): string {
    const date = new Date(dateInput);

    // Return early if the date is invalid
    if (isNaN(date.getTime())) return "Ngày không hợp lệ";

    const formatter = new Intl.DateTimeFormat("vi-VN", {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "Asia/Ho_Chi_Minh",
    });

    return formatter.format(date);
}

// ==================== XỬ LÝ ASSETS ====================
const getAssets = () => {
    const rawImgAssets = import.meta.glob("./**/**/*.{jpg,png,svg,webp}", {
        eager: true,
    });

    const rawVidAssets = import.meta.glob("./**/**/*.mp4", {
        eager: true,
        query: "?url",
        import: "default",
    });

    return { rawImgAssets, rawVidAssets };
};

const assets = getAssets();

// Xử lý ảnh và video - trả về URL đúng
const processedImages = images?.map((imgName) => {
    if (imgName === "none") return "none";

    for (const [path, module] of Object.entries(assets.rawImgAssets)) {
        if (path.includes(imgName) || path.endsWith(imgName)) {
            return (module as any).default || module; // Đảm bảo lấy URL
        }
    }
    return imgName;
});

const processedVideos = videos?.map((vidName) => {
    if (vidName === "none") return "none";

    for (const [path, module] of Object.entries(assets.rawVidAssets)) {
        if (path.includes(vidName) || path.endsWith(vidName)) {
            return module;
        }
    }
    return vidName;
});

const mainVideo = processedVideos?.[0] || null;
const previewImages = processedImages?.slice(0, 10) || [];
---

<Layout>
    <BaseHead />
    <body>
        <main class="flex flex-col items-center w-full">
            <div class="text-2xl" id="container">
                <!-- Danh mục -->
                <div class="bg-gray-900 catName mb-3">
                    <p>Danh mục: {parent === "none" ? catergory : parent}</p>
                </div>

                <div class="mb-8">
                    <h1 class="text-5xl font-semibold leading-tight">
                        {title}
                    </h1>
                </div>
                <!-- Preview + Form -->
                <div
                    id="desimg"
                    class="flex flex-col gap-12 w-full max-w-6xl mx-auto mb-12"
                >
                    <!-- PREVIEW -->
                    <div class="flex flex-col gap-6">
                        <!-- Video -->
                        {
                            mainVideo && mainVideo !== "none" && (
                                <div class="w-full aspect-video bg-black rounded-3xl overflow-hidden shadow-2xl">
                                    <ImportMedia
                                        productId={id}
                                        mediaName={mainVideo}
                                        type="video"
                                    />
                                </div>
                            )
                        }

                        <!-- Grid ảnh -->
                        <div>
                            <p class="text-lg font-medium text-gray-900 mb-4">
                                Hình ảnh chi tiết sản phẩm
                            </p>
                            <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
                                {
                                    previewImages.map(
                                        (img, index) =>
                                            img !== "none" && (
                                                <div class="aspect-square rounded-2xl overflow-hidden border border-gray-700 hover:border-violet-500 transition-all duration-300">
                                                    <ImportMedia
                                                        productId={id}
                                                        mediaName={img}
                                                        type="image"
                                                    />
                                                </div>
                                            ),
                                    )
                                }
                            </div>
                        </div>
                    </div>

                    <!-- CHỌN QUY CÁCH -->
                    <div class="p-8 rounded-3xl border border-gray-700">
                        <h2 class="text-3xl font-bold mb-6">Chọn quy cách</h2>

                        <form action="#" class="space-y-8">
                            <div>
                                <label
                                    for="Size"
                                    class="block text-sm mb-2 text-gray-400"
                                    >Chọn cỡ túi:</label
                                >
                                <select
                                    class="w-full bg-gray-800 border border-gray-600 text-white p-4 rounded-2xl focus:border-violet-500 outline-none"
                                    name="kraft"
                                    id="kraft"
                                >
                                    <option value="20x10">Túi 20x10</option>
                                    <option value="20x20">Túi 20x20</option>
                                    <option value="16x16">Túi 16x16</option>
                                </select>
                            </div>

                            <div>
                                <label
                                    for="Mau"
                                    class="block text-sm mb-2 text-gray-400"
                                    >Chọn mẫu:</label
                                >
                                <select
                                    class="w-full bg-gray-800 border border-gray-600 text-white p-4 rounded-2xl focus:border-violet-500 outline-none"
                                    name="mau"
                                    id="mau"
                                >
                                    <option value="cute01">Mẫu Cute 01</option>
                                    <option value="cute02">Mẫu Cute 02</option>
                                    <option value="cute03">Mẫu Cute 03</option>
                                    <option value="cute04">Mẫu Cute 04</option>
                                    <option value="cute05">Mẫu Cute 05</option>
                                    <option value="cute06">Mẫu Cute 06</option>
                                    <option value="cute07">Mẫu Cute 07</option>
                                    <option value="cute08">Mẫu Cute 08</option>
                                </select>
                            </div>

                            <input
                                type="submit"
                                value="Đặt túi ngay !"
                                class="w-full py-5 bg-linear-to-r from-[#781722] to-[#a13a4d] text-white font-bold text-xl rounded-2xl hover:brightness-110 active:scale-[0.98] transition-all cursor-pointer"
                            />
                        </form>
                    </div>
                </div>

                <!-- Phần mô tả -->
                <div
                    id="description"
                    class="text-center leading-12 border border-sky-100 rounded-3xl p-8 mb-8"
                >
                    <img
                        id="background"
                        src={background.src}
                        alt=""
                        fetchpriority="high"
                    />

                    <div
                        class="mx-auto mb-4
                        text-left
                    MardownContent flex flex-col lg:max-w-[55vw]"
                    >
                        <slot />
                    </div>
                    <div id="desdate" class="text-[.8rem] pb-2">
                        <p>Cập nhật ngày: {date}</p>
                    </div>
                </div>
            </div>
        </main>
    </body>
    <Footer />
</Layout>

<style is:global>
    #container {
        font-family: Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
        width: 1440px;
        max-width: 100%;
        margin: 0 auto;
    }

    .catName p {
        color: lightgray;
        padding: 0.5rem;
        font-weight: 400;
    }

    #background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: -1;
        filter: blur(100px);
    }

    /* Responsive Grid */
    @media (max-width: 1023px) {
        #desimg {
            gap: 3rem;
        }
    }

    .MardownContent img {
        width: 50%;
        margin: 1.5rem auto;
        border-radius: 12px;
    }

    .MardownContent p,
    .MardownContent a,
    .MardownContent li {
        text-align: left;
        font-size: 1.2rem;
        padding-bottom: 0.2rem;
    }

    .MardownContent h1 {
        margin-bottom: 5rem;
        font-size: 2rem;
    }

    .MardownContent h2 {
        font-size: 1.8rem;
        font-weight: 500;
    }

    .MardownContent h3 {
        font-size: 1.5rem;
        font-weight: 500;
        color: lightcoral;
    }
    .MardownContent hr {
        border: 0.1rem darkviolet;
        border-style: dashed none none none;
        margin-top: 2rem !important;
        margin-bottom: 2rem !important;
        width: 60%;
        height: 1rem;
        margin: auto;
    }

    @media (max-width: 768px) {
        .MardownContent p {
            font-size: 1rem;
            max-width: 100vw;
        }
    }
</style>
