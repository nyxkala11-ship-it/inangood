---
// src/components/Menu.astro
import { getCollection } from "astro:content";
import { GripVerticalIcon, HomeIcon, LogsIcon, X } from "@lucide/astro";

const allProducts = await getCollection("blogCollection");

const sortedProducts = [...allProducts].sort(
    (a, b) => (a.data.index ?? 999) - (b.data.index ?? 999),
);

interface MenuItem {
    id: string;
    title: string;
    slug: string;
    children: MenuItem[];
}

// Xây dựng menu
const categoryMap = new Map<string, MenuItem>();

sortedProducts.forEach((product) => {
    if (product.data.parent === "none") {
        const menuItem: MenuItem = {
            id: product.id,
            title: product.data.title,
            slug: `/products/${product.id}`,
            children: [],
        };
        categoryMap.set(product.data.catergory || product.id, menuItem);
    }
});

sortedProducts.forEach((product) => {
    if (product.data.parent !== "none") {
        const parent = categoryMap.get(product.data.parent);
        if (parent) {
            parent.children.push({
                id: product.id,
                title: product.data.title,
                slug: `/products/${product.id}`,
                children: [],
            });
        }
    }
});

const rootMenus = Array.from(categoryMap.values());
---

<nav class="menu-container max-w-360 mx-auto px-4">
    <!-- Desktop + Mobile Container -->
    <div class="flex items-center justify-between">
        <!-- Main Menu -->
        <ul id="mainMenu" class="main-menu onlyCom">
            <li class="menu-item">
                <a href="/">Trang chủ</a>
            </li>

            {
                rootMenus.map((item) => (
                    <li
                        class={`menu-item ${item.children.length > 0 ? "has-dropdown" : ""}`}
                        data-category={item.id}
                    >
                        <a href={item.slug}>
                            {item.title}
                            {item.children.length > 0 && (
                                <GripVerticalIcon
                                    size={18}
                                    class="inline ml-1"
                                />
                            )}
                        </a>

                        {item.children.length > 0 && (
                            <ul class="dropdown-menu">
                                {item.children.map((child) => (
                                    <li key={child.id}>
                                        <a href={child.slug}>{child.title}</a>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </li>
                ))
            }
        </ul>

        <!-- ==================== MOBILE NAVBAR (App Style) ==================== -->
        <div class="mobile-navbar md:hidden onlyMobile">
            <button id="menuMobileBtn" class="mobile-btn" aria-label="Mở menu">
                <LogsIcon size={28} />
            </button>
            <a href="/" class="mobile-home-btn">
                <HomeIcon size={28} />
            </a>
        </div>

        <!-- Mobile Menu Overlay -->
        <div id="mobileMenuOverlay" class="mobile-overlay">
            <div class="mobile-menu-panel">
                <div class="mobile-menu-header">
                    <button id="closeMobileMenu" class="close-btn">
                        <X size={32} />
                    </button>
                    <h2 class="text-2xl font-bold text-[#781722]">
                        Danh mục sản phẩm
                    </h2>
                </div>

                <ul class="mobile-menu-list">
                    <li>
                        <a href="/" class="mobile-home-link">🏠 Trang chủ</a>
                    </li>
                    {
                        rootMenus.map((item) => (
                            <li
                                class={
                                    item.children.length > 0
                                        ? "has-children"
                                        : ""
                                }
                            >
                                <a href={item.slug} class="parent-link">
                                    {item.title}
                                </a>
                                {item.children.length > 0 && (
                                    <ul class="mobile-submenu">
                                        {item.children.map((child) => (
                                            <li>
                                                <a href={child.slug}>
                                                    {child.title}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </div>
</nav>

<style>
    .onlyCom {
        display: block;
    }
    .onlyMobile {
        display: none !important;
    }
    .menu-container {
        width: 1440px;
        max-width: 100%;
        margin: 0 auto;
    }

    .main-menu {
        display: flex;
        flex-wrap: wrap;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 0.5rem;
    }

    .menu-item {
        position: relative;
        padding: 0.65rem 1.1rem;
        font-size: 1.32rem;
        font-weight: 700;
        transition: all 0.3s;
    }

    .menu-item a {
        color: inherit;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .menu-item:hover {
        color: #781722;
    }

    /* Dropdown Desktop */
    .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background: #fff;
        color: #222;
        padding: 1rem 0;
        border-radius: 8px;
        min-width: 260px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        z-index: 1000;
        list-style: none;
    }

    .has-dropdown:hover .dropdown-menu {
        display: block;
    }

    .dropdown-menu li a {
        padding: 0.6rem 1.4rem;
        font-size: 1.1rem;
        font-weight: 500;
        display: block;
    }

    .dropdown-menu li a:hover {
        background: #f8f8f8;
        color: #781722;
    }

    /* ==================== MOBILE APP NAVBAR ==================== */
    .mobile-navbar {
        position: fixed;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(20px);
        border-radius: 9999px;
        padding: 10px 28px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
        z-index: 999;
        display: flex;
        align-items: center;
        gap: 36px;
        border: 1px solid rgba(120, 23, 34, 0.1);
    }

    .mobile-btn,
    .mobile-home-btn {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .mobile-btn:active {
        transform: scale(0.85);
        background: #f1f1f1;
    }

    /* Mobile Overlay + Animation mượt */
    .mobile-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(10px);
        z-index: 1000;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s ease;
    }

    .mobile-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .mobile-menu-panel {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        border-top-left-radius: 28px;
        border-top-right-radius: 28px;
        height: 85vh;
        transform: translateY(120%);
        transition: transform 0.6s cubic-bezier(0.32, 0.72, 0, 1);
        box-shadow: 0 -20px 50px rgba(0, 0, 0, 0.3);
        overflow-y: auto;
    }

    .mobile-overlay.active .mobile-menu-panel {
        transform: translateY(0);
    }

    .mobile-menu-header {
        padding: 1.4rem 1.5rem;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }

    .close-btn {
        transition: all 0.3s ease;
    }
    .close-btn:active {
        transform: rotate(90deg) scale(0.85);
    }

    .mobile-menu-list a {
        display: block;
        padding: 16px 1.5rem;
        font-size: 1.18rem;
        font-weight: 500;
        color: #333;
        transition: all 0.3s ease;
    }
    .mobile-menu-list a:active {
        background: #f8f8f8;
        padding-left: 2.2rem;
    }

    .parent-link {
        font-weight: 700 !important;
        color: #781722 !important;
    }
    @media screen and (max-width: 600px) {
        .onlyCom {
            display: none;
        }
        .onlyMobile {
            display: flex !important;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const menuBtn = document.getElementById("menuMobileBtn");
        const overlay = document.getElementById("mobileMenuOverlay");
        const closeBtn = document.getElementById("closeMobileMenu");

        if (menuBtn && overlay && closeBtn) {
            menuBtn.addEventListener("click", () => {
                overlay.classList.add("active");
                document.body.style.overflow = "hidden";
            });

            closeBtn.addEventListener("click", () => {
                overlay.classList.remove("active");
                document.body.style.overflow = "visible";
            });

            overlay.addEventListener("click", (e) => {
                if (e.target === overlay) {
                    overlay.classList.remove("active");
                    document.body.style.overflow = "visible";
                }
            });
        }
    });
</script>
