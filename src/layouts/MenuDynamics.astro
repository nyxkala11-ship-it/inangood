---
import { getCollection, render } from "astro:content";
import { GripVerticalIcon, HomeIcon, LogsIcon } from "@lucide/astro";
const allProducts = await getCollection("blogCollection");

const sortedProducts = [...allProducts].sort((a, b) => {
    console.log("srt tăng dần");
    return a.data.index - b.data.index;
});

console.log("=== SORTED: Index items first, then no-index ===");
sortedProducts.forEach((product, i) => {
    const index = product.data.index;
    console.log(
        `${i + 1}. ${product.data.title} - Index: ${index || "NO INDEX"}`,
    );
});

interface MenuItem {
    id: string;
    title: string;
    slug: string;
    index: number;
    category: string;
    children: MenuItem[];
}

const productMap = new Map<string, MenuItem>();
const categoryMap = new Map<string, MenuItem>();

console.log("=== TOTAL PRODUCTS:", allProducts.length);
console.log("========================================");
sortedProducts.forEach((product) => {
    if (product.data.parent === "none") {
        const menuItem: MenuItem = {
            id: product.id,
            title: product.data.title,
            slug: `/products/${product.id}`,
            index: product.data.index,
            category: product.data.catergory,
            children: [],
        };
        categoryMap.set(product.data.catergory, menuItem);
        productMap.set(product.id, menuItem);
    }
});

sortedProducts.forEach((product) => {
    if (product.data.parent !== "none") {
        const menuItem: MenuItem = {
            id: product.id,
            title: product.data.title,
            slug: `/products/${product.id}`,
            index: product.data.index,
            category: product.data.catergory,
            children: [],
        };
        productMap.set(product.id, menuItem);
        const parentItem = categoryMap.get(product.data.parent);
        if (parentItem) {
            parentItem.children.push(menuItem);
        } else {
        }
    }
});

const rootMenus = Array.from(categoryMap.values());
---

<div class="menu-container flex flex-cols justify-center">
    <div class="menu-mobile-btn bg-sky-100">
        <button id="menuMobileBtn">
            <LogsIcon size="2rem" class="inline" />
        </button>
        <form action="/" id="homeMobileBtn" class="inline">
            <button type="submit">
                <HomeIcon size="2rem" class="inline" />
            </button>
        </form>
    </div>
    <ul id="mainMenu" class="main-menu">
        <li class="menu-item">
            <a href="/">Trang chủ</a>
        </li>
        {
            rootMenus.map((menuitem) => (
                <li
                    class={`menu-item ${menuitem.children.length > 0 ? "has-dropdown" : ""}`}
                >
                    <a href={menuitem.slug}>
                        {menuitem.title}{" "}
                        {menuitem.children.length > 0 ? (
                            <GripVerticalIcon class="inline" />
                        ) : (
                            ""
                        )}
                    </a>
                    {menuitem.children.length > 0 && (
                        <ul class="dropdown-menu">
                            {menuitem.children.map((child) => (
                                <li>
                                    <a href={child.slug}>{child.title}</a>
                                </li>
                            ))}
                        </ul>
                    )}
                </li>
            ))
        }
    </ul>
</div>

<style is:global>
    .menu-container {
        width: 100%;
        margin-top: 10px;
        border-radius: 5px;
    }

    .main-menu {
        max-width: 1440px;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        list-style: none;
        margin: 0;
        padding: 0;
        transition: all 1s;
    }

    .menu-item {
        position: relative;
        padding: 6pt 1.5rem 6pt 6pt;
        transition: all 1s;
    }

    .menu-item a {
        font-size: 1.3rem;
        font-weight: 700;
        text-decoration: none;
        color: inherit;
    }

    .menu-item:hover {
        //background-color: aliceblue;
        color: black;
    }

    .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background-color: aliceblue;
        color: #000;
        padding: 1rem;
        border-radius: 5px;
        min-width: 240px;
        list-style: none;
        margin: 0;
        z-index: 999;
        margin-left: 0rem;
        overflow: auto;
        max-width: 350px;
        transition: all 1s;
        cursursor: pointer;
    }

    .has-dropdown:hover .dropdown-menu {
        display: block;
        margin-top: 0.2rem;
    }

    .dropdown-menu li {
        padding: 8px 0;
        transition: all 1s;
    }

    .dropdown-menu li a {
        font-size: 1rem;
        transition: all 1s;
    }

    .menu-mobile-btn {
        display: none;
    }

    @media screen and (max-width: 600px) {
        .menu-mobile-btn {
            display: block;
            padding: 10px;
            background: none;
            border: 0.05rem solid slategray;
            cursor: pointer;
            position: fixed;
            bottom: 0.5rem;
            left: 50%;
            transform: translateX(-50%);
            width: 95%;
            height: 3.67rem;
            z-index: 990;
            border-radius: 5rem;
            background: #ededed;
            background: linear-gradient(
                148deg,
                rgba(237, 237, 237, 0.15) 0%,
                rgba(255, 255, 255, 0.15) 50%,
                rgba(186, 186, 186, 0.15) 100%
            );
            backdrop-filter: blur(0.15rem);
        }

        #menuMobileBtn {
            position: fixed;
            border: 0.005rem solid darkslategrey;
            border-radius: 5rem;
            padding: 0.75rem;
            transform: translate(-17.5%, -17%);
            background: #ededed;
            background: linear-gradient(
                148deg,
                rgba(237, 237, 237, 0.5) 0%,
                rgba(255, 255, 255, 0.5) 50%,
                rgba(186, 186, 186, 0.5) 100%
            );
            backdrop-filter: blur(0.5rem);
        }
        #homeMobileBtn {
            border: 0.01rem solid darkgrey;
            border-radius: 5rem;
            padding: 0.9rem;
            position: fixed;
            left: 50%;
            transform: translateX(-50%) translateY(-21.5%);
            background: #ededed;
            background: linear-gradient(
                148deg,
                rgba(237, 237, 237, 0.8) 0%,
                rgba(255, 255, 255, 0.8) 50%,
                rgba(186, 186, 186, 0.8) 100%
            );
            backdrop-filter: blur(1.8rem);
        }

        .main-menu {
            padding: 0.5rem;
            color: rgba(100, 100, 100);
            display: none;
            flex-direction: row;
            position: fixed;
            bottom: 0;
            z-index: 999;
            transition: all 1s;
            background: #ededed;
            background: linear-gradient(
                148deg,
                rgba(207, 207, 207, 0.75) 0%,
                rgba(255, 255, 255, 0.75) 50%,
                rgba(222, 222, 222, 0.75) 100%
            );
            height: 80vh;
            width: 75vw;
            overflow-y: scroll;
            border-radius: 0.8rem;
            border: 0.01rem solid powderblue;
            backdrop-filter: blur(0.2rem);
            /*
            -webkit-box-shadow:
                inset 0.2em 0.2em 0.2em 0 rgba(255, 255, 255, 0.5),
                inset -0.2em -0.2em 0.2em 0 rgba(0, 0, 0, 0.5),
                0.2em 0.2em 0.2em 0 rgba(0, 0, 0, 0.34),
                -0.2em -0.2em 0.2em 0 rgba(255, 255, 255, 1);
            -moz-box-shadow:
                inset 0.2em 0.2em 0.2em 0 rgba(255, 255, 255, 0.5),
                inset -0.2em -0.2em 0.2em 0 rgba(0, 0, 0, 0.5),
                0.2em 0.2em 0.2em 0 rgba(0, 0, 0, 0.34),
                -0.2em -0.2em 0.2em 0 rgba(255, 255, 255, 1);
            box-shadow:
                inset 0.2em 0.2em 0.2em 0 rgba(255, 255, 255, 0.5),
                inset -0.2em -0.2em 0.2em 0 rgba(0, 0, 0, 0.5),
                0.2em 0.2em 0.2em 0 rgba(0, 0, 0, 0.34),
                -0.2em -0.2em 0.2em 0 rgba(255, 255, 255, 1);
                 */
        }

        .main-menu.active {
            display: block;
            position: fixed;
            bottom: 4.8rem;
            left: 0.5rem;
        }

        .menu-item {
            width: 100%;
        }

        .dropdown-menu {
            position: static;
            display: none;
            padding-left: 20px;
            transition: all 1s;
        }

        .has-dropdown.active .dropdown-menu {
            display: block;
        }
    }
</style>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const menuBtn = document.getElementById("menuMobileBtn");
        const mainMenu = document.getElementById("mainMenu");

        if (menuBtn && mainMenu) {
            menuBtn.addEventListener("click", () => {
                mainMenu.classList.toggle("active");
            });

            // Mobile dropdown toggle
            if (window.innerWidth <= 600) {
                const dropdownItems =
                    document.querySelectorAll(".has-dropdown > a");
                dropdownItems.forEach((item) => {
                    item.addEventListener("click", (e) => {
                        e.preventDefault();
                        const parent = item.parentElement;
                        parent!.classList.toggle("active");
                    });
                });
            }
        }
    });
</script>
