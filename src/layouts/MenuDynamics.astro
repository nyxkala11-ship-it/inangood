<!-- Main Menu <Debug {products} />-->
    
     <div class="flex flex-col items-center">

            <div id="Menu" class="items-center shadow-xl">

                <div id="MenuMobile" class="my-2">
                    <LogsIcon size="32" class="inline" />
                    <p class="inline pl-2">Menu</p>
                </div>
                <ul id="MenuCom" class="flex items-start flex-wrap">
					
                    <!-- Trang chủ -->
                    <li id="Menu-items-tt">
						<a href="/">
							Trang chủ (Dynamics)
						</a>
					</li>
                    {ProductsCol.filter(product => product.data.parent === 'none').map((product) => 
                        
                        <ul id={product.data.index} class={`${product.data.catergory} drophover Menu-items parent`}>
                            <a href={`/products/${product.id}`} class={`menitext`} id={product.data.index}>
                                    {product.data.title}
                            </a>

                            <!-- parent nếu có -->
                            <ul class="bg-sky-500 drop">
                                {ProductsCol.filter(productsub => productsub.data.parent === product.data.catergory).map(
                                    productsub => 
                                    productsub.data.parent === product.data.catergory ?
                                        <li id={product.data.catergory} class={`${productsub.data.catergory} menitext flex min-w-[240px] flex-col gap-1 p-1.5 child`}>                                            <a href={`/products/${productsub.id}`}>
                                                <a href={`/products/${productsub.id}`}>{productsub.data.title}</a>
                                                    
                                                </a>
                                        </li> : null
                                )}
                            </ul>
                        </ul>
                            )
                            }
                    
                </ul>

            </div> 
	
    </div>

<style>
    
    #Menu {
        width: 1440px;
        max-width: 100%;
        margin-top: 10px;
        border-radius: 5px;
    }
    #MenuMobile {
        display: none;
    }
    .Menu-items {
        padding: 6pt;
        padding-right: 1.5rem;
    }
    .Menu-items a {
            font-size: 1.3rem;
    }
    #Menu-items-tt {
        padding: 6pt;
        padding-right: 1.5rem;
    }
    #Menu-items-tt a {
            font-size: 1.3rem;
    }
    
    .drophover {
        display: inline-block;
        float: left;
        overflow: auto;
        cursursor: pointer;
    }
    .drop {
        display: none;
        z-index: 999;
        cursursor: pointer;
    }
    .drophover:hover {
        background-color: aliceblue;
        transition: .35s, display .45s;
        cursursor: pointer;
    }
    
    .drophover:hover .drop{
        margin-top: 7pt;
        margin-left: -7pt;
        display: block;
        overflow: auto;
        position: absolute;
        max-width: 350px;
        background-color: aliceblue;
        padding: 15px;
        border-radius: 5px;
        transition: 0.35s, display .45s;
        cursursor: pointer;
    }

    @media screen and (max-width: 600px) {
        #Menu-items a {
            font-size: 1rem;
        }
        #Menu-items {
            background-color: aqua;
        }
        #MenuMobile {
            display: block;
            transition: all 0.5s;
        }
        #MenuMobile:hover {
            background-color: aqua;
            display: block;
        }
        #MenuCom {
            display: none;
        }
        #MenuMobile p{
            font-size: larger;
        }
    }
</style>

<script defer>
const para = document.createElement("p");
document.addEventListener("DOMContentLoaded", sortList);
document.addEventListener("DOMContentLoaded", appendList);

    function sortList() {
        let list, one, i, j, switching, b, shouldSwitch;
        // Lấy thuộc tính có id là Menu (bao gồm cả Menu com và mobile)
        list = document.getElementById("Menu");
        // switching dùng để kiểm tra xem có tiếp tục switch danh sách hay không
        switching = true;
        // one dùng gỡ lỗi một lần
        one = true;
        while (switching) {
            // tắt switching dùng để kiểm tra xem có tiếp tục switch danh sách hay không
            switching=false;

            // lấy danh sách các ul có trong id Menu
            b = list.getElementsByTagName("ul");

            while (one == true) {
                one = false;
            }

            // Nếu id không đặt index, mặc định index = 0 để sort
            for (i=0; i< (b.length - 1); i++) {
                if (b[i].id === "") {
                    b[i].setAttribute('id', '0');
                }
            }

            /// sort theo thứ số nguyên, nếu id hiện tại lớn hơn id phía sau thì
            // thực hiện switch bằng cách đặt shouldSwitch = true
            for (i=0; i< (b.length - 1); i++) {
                shouldSwitch = false;
                if (parseInt(b[i].id) > parseInt(b[i+1].id)) {
                shouldSwitch = true;
                break;
            }
        }
            /// chèn vị trí sau lên trước id hiện tại nếu id hiện tại lớn hơn
            if (shouldSwitch) {
                console.log(`${b[i].parentElement}`);
                b[i].parentElement.insertBefore(b[i + 1], b[i]);
                switching = true;
            }
        }

        return b;
    }
